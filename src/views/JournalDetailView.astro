---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ClusitArticle from "@/components/article/ClusitArticle.astro";
import { render, type CollectionEntry } from "astro:content";
import { type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";
import { slugOf } from "@/lib/content";

interface Props {
  lang: Locale;
  post: CollectionEntry<"journal">;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { title, description, date, tags } = post.data;
const locale = lang === "it" ? "it-IT" : "en-US";

// Articoli interattivi con layout personalizzato (per slug)
const slug = slugOf(post.id);
const interactive: Record<string, boolean> = {
  "cybersecurity-clusit-2024-2026": true,
};
const isInteractive = interactive[slug] === true;
const { Content } = isInteractive
  ? { Content: null }
  : await render(post);
---
<BaseLayout lang={lang} title={title} description={description}>
  <article class="section">
    <div class="container">
      <Breadcrumb
        items={[
          { label: t("nav.home"), href: localePath(lang, "/") },
          { label: t("nav.journal"), href: localePath(lang, "/journal") },
          { label: title },
        ]}
      />

      {
        isInteractive ? (
          <ClusitArticle lang={lang} />
        ) : (
          <>
            <header class="detail-head">
              <p class="post-date">
                {date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}
              </p>
              <h1>{title}</h1>
              {tags.length > 0 && (
                <ul class="detail-tags" role="list">
                  {tags.map((tg) => <li class="tag tag--neutral">{tg}</li>)}
                </ul>
              )}
            </header>

            {Content && (
              <Prose class="detail-body">
                <Content />
              </Prose>
            )}
          </>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .detail-head h1 {
    font-size: var(--step-3);
    max-width: 24ch;
  }
  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .detail-body {
    margin-top: 2rem;
  }
</style>
