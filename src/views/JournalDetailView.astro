---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Icon from "@/components/Icon.astro";
import { render, type CollectionEntry } from "astro:content";
import { type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";

interface Props {
  lang: Locale;
  post: CollectionEntry<"journal">;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { title, description, date, tags } = post.data;
const { Content } = await render(post);
const locale = lang === "it" ? "it-IT" : "en-US";
---
<BaseLayout lang={lang} title={title} description={description}>
  <article class="section">
    <div class="container">
      <a class="back" href={localePath(lang, "/journal")}>
        <Icon name="chevronRight" size={16} class="flip" />
        {t("nav.journal")}
      </a>

      <header class="detail-head">
        <p class="post-date">
          {date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}
        </p>
        <h1>{title}</h1>
        {
          tags.length > 0 && (
            <ul class="detail-tags" role="list">
              {tags.map((tg) => <li class="tag">{tg}</li>)}
            </ul>
          )
        }
      </header>

      <Prose class="detail-body">
        <Content />
      </Prose>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-weight: 550;
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--accent);
  }
  .back :global(.flip) {
    transform: rotate(180deg);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .detail-head h1 {
    font-size: var(--step-3);
    max-width: 24ch;
  }
  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .detail-body {
    margin-top: 2rem;
  }
</style>
