---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const desc =
  lang === "it"
    ? "Contatta Chiara Berti: modulo, email e social."
    : "Get in touch with Chiara Berti: form, email and socials.";
const intro =
  lang === "it"
    ? "Hai un progetto, un'opportunità o una domanda? Scrivimi: rispondo volentieri."
    : "Have a project, an opportunity or a question? Drop me a line — I'll be glad to reply.";
---
<BaseLayout lang={lang} title={t("nav.contact")} description={desc}>
  <section class="section">
    <div class="container contact-grid" data-reveal-group>
      <div>
        <SectionHeader eyebrow={t("nav.contact")} title={t("section.contact")} intro={intro} level="h1" />
        <div class="contact-card card">
          <a class="contact-row" href={`mailto:${site.email}`}>
            <span class="contact-ico" aria-hidden="true"><Icon name="mail" size={18} /></span>
            <span>
              <span class="contact-label">Email</span>
              <span class="contact-value">{site.email}</span>
            </span>
          </a>
          <div class="contact-row contact-row--static">
            <span class="contact-ico" aria-hidden="true"><Icon name="mapPin" size={18} /></span>
            <span>
              <span class="contact-label">{lang === "it" ? "Dove" : "Location"}</span>
              <span class="contact-value">{site.location} <span class="contact-tz">· CET</span></span>
            </span>
          </div>
        </div>
        <div class="direct-socials">
          <SocialLinks size={18} exclude={["email"]} />
        </div>
      </div>
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
  }
  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .contact-card {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.4rem);
  }
  .contact-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    transition: background 0.2s ease;
  }
  a.contact-row:hover {
    background: var(--accent-soft);
  }
  .contact-row--static {
    cursor: default;
  }
  .contact-ico {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact-value {
    display: block;
    font-weight: 550;
  }
  .contact-tz {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .direct-socials {
    margin-top: 1.75rem;
  }
</style>
