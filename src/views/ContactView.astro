---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const desc =
  lang === "it"
    ? "Contatta Chiara Berti: modulo, email e social."
    : "Get in touch with Chiara Berti: form, email and socials.";
const intro =
  lang === "it"
    ? "Hai un progetto, un'opportunità o una domanda? Scrivimi: rispondo volentieri."
    : "Have a project, an opportunity or a question? Drop me a line — I'll be glad to reply.";
---
<BaseLayout lang={lang} title={t("nav.contact")} description={desc}>
  <section class="section">
    <div class="container contact-grid" data-reveal-group>
      <div>
        <SectionHeader eyebrow={t("nav.contact")} title={t("section.contact")} intro={intro} />
        <div class="direct">
          <p class="muted">{t("contact.orEmail")}</p>
          <a class="direct-mail" href={`mailto:${site.email}`}>
            <Icon name="mail" size={20} />
            {site.email}
          </a>
          <div class="direct-socials">
            <SocialLinks size={18} exclude={["email"]} />
          </div>
        </div>
      </div>
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
  }
  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .direct {
    margin-top: 1.5rem;
  }
  .direct-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--accent);
  }
  .direct-mail:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .direct-socials {
    margin-top: 1.75rem;
  }
</style>
