---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = content[lang].cv;
const desc =
  lang === "it"
    ? "Curriculum di Chiara Berti: esperienza, formazione e certificazioni."
    : "Chiara Berti's resume: experience, education and certifications.";
---
<BaseLayout lang={lang} title={t("nav.cv")} description={desc}>
  <section class="section">
    <div class="container">
      <div class="cv-head">
        <SectionHeader eyebrow={t("nav.cv")} title={t("section.experience")} />
        {
          site.features.cvDownload && (
            <a class="btn btn--primary" href={site.cvFile} download>
              <Icon name="download" size={18} />
              {t("cta.downloadCv")}
            </a>
          )
        }
      </div>

      <ol class="timeline" role="list">
        {
          cv.experience.map((item) => (
            <li class="timeline-item">
              <div class="timeline-marker" aria-hidden="true" />
              <div class="timeline-content card">
                <p class="timeline-period">{item.period}{item.location ? ` · ${item.location}` : ""}</p>
                <h3 class="timeline-role">{item.role}</h3>
                <p class="timeline-org">{item.org}</p>
                <p class="muted timeline-desc">{item.description}</p>
                {item.tags && item.tags.length > 0 && (
                  <ul class="timeline-tags" role="list">
                    {item.tags.map((tg) => (
                      <li class="tag">{tg}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container cv-two-col">
      <div>
        <SectionHeader eyebrow="Education" title={t("section.education")} />
        <div class="stack">
          {
            cv.education.map((ed) => (
              <div class="card cv-block">
                <p class="timeline-period">{ed.period}</p>
                <h3 class="cv-block-title">{ed.title}</h3>
                <p class="timeline-org">{ed.org}</p>
                {ed.description && <p class="muted">{ed.description}</p>}
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <SectionHeader eyebrow="Certifications" title={t("section.certifications")} />
        <div class="stack">
          {
            cv.certifications.map((c) => (
              <div class="card cv-block">
                <p class="timeline-period">{c.year}</p>
                <h3 class="cv-block-title">
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener noreferrer">
                      {c.title}
                    </a>
                  ) : (
                    c.title
                  )}
                </h3>
                <p class="timeline-org">{c.org}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1.5rem;
  }
  .timeline-item::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.4rem;
    bottom: -0.4rem;
    width: 2px;
    background: var(--border);
  }
  .timeline-item:last-child::before {
    display: none;
  }
  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .timeline-period,
  .cv-block .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .timeline-role,
  .cv-block-title {
    font-size: var(--step-1);
  }
  .timeline-org {
    color: var(--accent);
    font-weight: 550;
    margin: 0.15rem 0 0.6rem;
  }
  .timeline-desc {
    font-size: 0.95rem;
  }
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  .cv-two-col {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 3.5rem);
  }
  @media (min-width: 800px) {
    .cv-two-col {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
