---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const cur = content[lang].curriculum;
const desc =
  lang === "it"
    ? "Curriculum di Chiara Berti: percorso, istruzione e certificazioni."
    : "Chiara Berti's curriculum: journey, education and certifications.";
---
<BaseLayout lang={lang} title={t("nav.cv")} description={desc}>
  <section class="section">
    <div class="container">
      <div class="cv-head">
        <SectionHeader eyebrow={t("nav.cv")} title={t("section.path")} />
        {
          site.features.cvDownload && (
            <a class="btn btn--primary" href={site.cvFile} download>
              <Icon name="download" size={18} />
              {t("cta.downloadCv")}
            </a>
          )
        }
      </div>
      <div class="stack cv-intro">
        {cur.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeader eyebrow="Education" title={t("section.education")} intro={cur.education.lead} />
      <div class="stack">
        {
          cur.education.items.map((ed) => (
            <div class="card cv-block">
              {ed.period && <p class="cv-period">{ed.period}</p>}
              <h3 class="cv-block-title">{ed.title}</h3>
              <p class="cv-org">{ed.org}</p>
              {ed.description && <p class="muted">{ed.description}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeader
        eyebrow="Certifications"
        title={t("section.certifications")}
        intro={cur.certifications.lead}
      />
      <div class="grid grid--2">
        {
          cur.certifications.items.map((c) => (
            <div class="card cv-block">
              <div class="cert-top">
                <span class="cv-period">{c.year}</span>
                {c.url && (
                  <a
                    class="cert-verify"
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${c.title} — verify`}
                  >
                    <Icon name="external" size={16} />
                  </a>
                )}
              </div>
              <h3 class="cv-block-title">{c.title}</h3>
              <p class="cv-org">{c.org}</p>
              {c.description && <p class="muted cert-desc">{c.description}</p>}
            </div>
          ))
        }
      </div>

      <div class="beyond">
        <h3 class="beyond-title">{t("section.beyondCerts")}</h3>
        <div class="stack beyond-text">
          {cur.certifications.beyond.paragraphs.map((p) => <p class="muted">{p}</p>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cv-intro {
    max-width: 65ch;
  }
  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.4rem;
    display: inline-block;
  }
  .cv-block-title {
    font-size: var(--step-1);
  }
  .cv-org {
    color: var(--accent);
    font-weight: 550;
    margin: 0.15rem 0 0.6rem;
  }
  .cert-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cert-verify {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .cert-verify:hover {
    color: var(--accent);
  }
  .cert-desc {
    font-size: 0.92rem;
  }
  .beyond {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .beyond-title {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .beyond-text {
    max-width: 65ch;
  }
</style>
