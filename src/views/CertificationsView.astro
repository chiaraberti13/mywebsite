---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";
import { type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const cert = content[lang].curriculum.certifications;
const desc =
  lang === "it"
    ? "Certificazioni di Chiara Berti: CompTIA Security+, Linux Essentials, Web Development Essentials, TryHackMe."
    : "Chiara Berti's certifications: CompTIA Security+, Linux Essentials, Web Development Essentials, TryHackMe.";
---
<BaseLayout lang={lang} title={t("nav.certifications")} description={desc}>
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Certifications"
        title={t("section.certifications")}
        intro={cert.lead}
      />
      <div class="grid grid--2" data-reveal-group>
        {
          cert.items.map((c) => (
            <div class="card cv-block">
              <div class="cert-top">
                <span class="cert-badge" aria-hidden="true">
                  <Icon name={c.icon ?? "shieldCheck"} size={22} />
                </span>
                {c.url && (
                  <a
                    class="cert-verify"
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${c.title} — verify`}
                  >
                    <Icon name="external" size={16} />
                  </a>
                )}
              </div>
              <span class="cv-period">{c.year}</span>
              <h3 class="cv-block-title">{c.title}</h3>
              <p class="cv-org">{c.org}</p>
              {c.description && <p class="muted cert-desc">{c.description}</p>}
            </div>
          ))
        }
      </div>

      <div class="beyond" data-reveal>
        <h3 class="beyond-title">{t("section.beyondCerts")}</h3>
        <div class="stack beyond-text">
          {cert.beyond.paragraphs.map((p) => <p class="muted">{p}</p>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.4rem;
    display: inline-block;
  }
  .cv-block-title {
    font-size: var(--step-1);
  }
  .cv-org {
    color: var(--accent);
    font-weight: 550;
    margin: 0.15rem 0 0.6rem;
  }
  .cert-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }
  .cert-badge {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .cert-verify {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .cert-verify:hover {
    color: var(--accent);
  }
  .cert-desc {
    font-size: 0.92rem;
  }
  .beyond {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .beyond-title {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .beyond-text {
    max-width: 65ch;
  }
</style>
