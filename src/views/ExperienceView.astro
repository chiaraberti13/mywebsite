---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const experience = content[lang].experience;
const desc =
  lang === "it"
    ? "Esperienze lavorative di Chiara Berti: dal design allo sviluppo e all'automazione."
    : "Chiara Berti's work experience: from design to development and automation.";
const intro =
  lang === "it"
    ? "Oltre dieci anni tra design, sviluppo software e automazione dei processi."
    : "Over ten years across design, software development and process automation.";
---
<BaseLayout lang={lang} title={t("section.experience")} description={desc}>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow={t("nav.experience")} title={t("section.experience")} intro={intro} level="h1" />

      <div class="timeline-wrap">
        <div class="timeline-progress" aria-hidden="true"><span class="timeline-cursor"></span></div>
        <ol class="timeline" role="list" data-reveal-group>
          {
            experience.map((item) => (
              <li class="timeline-item">
                <div class="timeline-marker" aria-hidden="true" />
                <div class="timeline-content card">
                <p class="timeline-period">{item.period}{item.location ? ` · ${item.location}` : ""}</p>
                <h3 class="timeline-role">{item.role}</h3>
                {item.org && <p class="timeline-org">{item.org}</p>}
                <div class="stack timeline-body">
                  {item.paragraphs.map((p) => <p class="muted">{p}</p>)}
                </div>
                {item.tags && item.tags.length > 0 && (
                  <ul class="timeline-tags" role="list">
                    {item.tags.map((tg) => (
                      <li class="tag">{tg}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1.75rem;
  }
  .timeline-item::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.4rem;
    bottom: -0.4rem;
    width: 2px;
    background: var(--border);
  }
  .timeline-item:last-child::before {
    display: none;
  }
  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
    z-index: 2;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .timeline-marker.active {
    background: var(--accent);
    transform: scale(1.15);
  }

  /* Wrapper per la linea di progresso + cursore che scende con lo scroll */
  .timeline-wrap {
    position: relative;
  }
  .timeline-progress {
    position: absolute;
    left: 6px;
    top: 0;
    width: 2px;
    height: 0;
    background: linear-gradient(var(--accent-hover), var(--accent));
    border-radius: 2px;
    pointer-events: none;
    z-index: 1;
    transition: height 0.12s linear;
  }
  .timeline-cursor {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent);
    transform: translate(-50%, 50%);
    box-shadow: 0 0 0 5px var(--accent-soft);
    z-index: 3;
  }
  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .timeline-role {
    font-size: var(--step-1);
  }
  .timeline-org {
    color: var(--accent);
    font-weight: 550;
    margin: 0.15rem 0 0.8rem;
  }
  .timeline-body {
    max-width: 68ch;
    font-size: 0.95rem;
  }
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  /* ── Zig-zag su desktop: card alternate attorno a una linea centrale ── */
  @media (min-width: 900px) {
    .timeline-progress {
      left: 50%;
      transform: translateX(-50%);
    }
    .timeline-item {
      width: 50%;
      padding-left: 0;
      padding-bottom: 2.5rem;
    }
    /* Segmento di linea statica portato al centro */
    .timeline-item::before {
      left: auto;
    }
    .timeline-item:nth-child(odd) {
      margin-left: 0;
      padding-right: 2.75rem;
    }
    .timeline-item:nth-child(odd)::before {
      right: -1px;
    }
    .timeline-item:nth-child(odd) .timeline-marker {
      left: auto;
      right: -7px;
    }
    .timeline-item:nth-child(even) {
      margin-left: 50%;
      padding-left: 2.75rem;
    }
    .timeline-item:nth-child(even)::before {
      left: -1px;
    }
    .timeline-item:nth-child(even) .timeline-marker {
      left: -7px;
    }
  }
</style>

<script>
  // Il cursore scende lungo la timeline seguendo lo scroll, dalla prima
  // esperienza all'ultima. (element.style via CSSOM non è bloccato dalla CSP.)
  const wrap = document.querySelector<HTMLElement>(".timeline-wrap");
  const prog = wrap?.querySelector<HTMLElement>(".timeline-progress");
  if (wrap && prog) {
    const markers = Array.from(wrap.querySelectorAll<HTMLElement>(".timeline-marker"));
    let firstC = 0;
    let lastC = 0;
    let wrapTop = 0;
    let centers: number[] = [];
    let ticking = false;

    function measure() {
      const wr = wrap!.getBoundingClientRect();
      wrapTop = wr.top + window.scrollY;
      centers = markers.map((m) => {
        const r = m.getBoundingClientRect();
        return r.top + r.height / 2 - wr.top;
      });
      if (centers.length) {
        firstC = centers[0];
        lastC = centers[centers.length - 1];
      }
      update();
    }

    function update() {
      const center = window.scrollY + window.innerHeight / 2;
      const start = wrapTop + firstC;
      const end = wrapTop + lastC;
      let f = (center - start) / (end - start || 1);
      f = Math.max(0, Math.min(1, f));
      const cursorY = firstC + f * (lastC - firstC);
      prog!.style.top = firstC + "px";
      prog!.style.height = f * (lastC - firstC) + "px";
      markers.forEach((m, i) => {
        m.classList.toggle("active", cursorY >= centers[i] - 1);
      });
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      }
    }

    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", measure);
    window.addEventListener("load", measure);
  }
</script>
