---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import GitHubPinned from "@/components/GitHubPinned.astro";
import { type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";
import { getProjects, slugOf } from "@/lib/content";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const professional = projects.filter((project) => project.data.category === "professional-work");

const desc =
  lang === "it"
    ? "Progetti di Chiara Berti tra cybersecurity, networking, automazione e sviluppo."
    : "Chiara Berti's projects across cybersecurity, networking, automation and development.";
const intro =
  lang === "it"
    ? "Una selezione di progetti che racconta il mio percorso tra cybersecurity, networking, automazione e sviluppo."
    : "A selection of projects reflecting my path across cybersecurity, networking, automation and development.";
---
<BaseLayout lang={lang} title={t("nav.projects")} description={desc}>
  <section class="section">
    <div class="container">
      <SectionHeader title={t("section.projects")} intro={intro} align="center" level="h1" />
      <GitHubPinned lang={lang} featuredFirst />
    </div>
  </section>

  {
    professional.length > 0 && (
      <section class="section professional-section">
        <div class="container">
          <SectionHeader
            title={lang === "it" ? "Progetti professionali" : "Professional projects"}
            intro={lang === "it"
              ? "Progetti realizzati in ambito aziendale: il codice sorgente non è pubblico, ma qui descrivo architettura, automazione, sicurezza e il mio contributo personale."
              : "Projects built in a corporate context: the source code is not public, but I document the architecture, automation, security choices and my contribution."}
          />
          <div class="professional-grid" data-reveal-group>
            {professional.map((project) => (
              <ProjectCard
                project={project}
                href={localePath(lang, `/projects/${slugOf(project.id)}`)}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .professional-section {
    background: var(--surface-2);
  }
  .professional-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.6rem + 1.5vw, 1.5rem);
  }
  @media (min-width: 760px) {
    .professional-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
