---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectFeatured from "@/components/ProjectFeatured.astro";
import { type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";
import { getProjects, slugOf, PROJECT_CATEGORIES, categoryLabel } from "@/lib/content";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const repoKey = (url?: string) => {
  if (!url) return undefined;
  return url.replace(/\/+$/, "").split("/").pop()?.toLowerCase();
};
const publicProjects = projects.filter((project) => Boolean(project.data.links.github));
const professional = projects.filter((project) => project.data.category === "professional-work");
const featured = publicProjects.find((project) => project.data.featured) ?? publicProjects[0];
const gridProjects = [...publicProjects, ...professional.filter((project) => !publicProjects.some((p) => p.id === project.id))];
const present = new Set(gridProjects.map((project) => project.data.category));
const filterCats = PROJECT_CATEGORIES.filter((category) => present.has(category.key));
const allLabel = lang === "it" ? "Tutte" : "All";
const desc =
  lang === "it"
    ? "Progetti di Chiara Berti tra cybersecurity, networking, automazione e sviluppo."
    : "Chiara Berti's projects across cybersecurity, networking, automation and development.";
const intro =
  lang === "it"
    ? "Una selezione di progetti che racconta il mio percorso tra cybersecurity, networking, automazione e sviluppo."
    : "A selection of projects reflecting my path across cybersecurity, networking, automation and development.";
---
<BaseLayout lang={lang} title={t("nav.projects")} description={desc}>
  <section class="section">
    <div class="container">
      <SectionHeader title={t("section.projects")} intro={intro} align="center" level="h1" />
      {
        publicProjects.length > 0 && (
          <div class="projects-featured" data-reveal data-pinned-feature>
            {publicProjects.map((project) => (
              <div
                data-featured-repo={repoKey(project.data.links.github)}
                hidden={project.id !== featured?.id}
              >
                <ProjectFeatured
                  project={project}
                  lang={lang}
                  href={project.data.links.github ?? localePath(lang, `/projects/${slugOf(project.id)}`)}
                />
              </div>
            ))}
          </div>
        )
      }
      {
        filterCats.length > 1 && (
          <div class="proj-filters" role="group" aria-label={t("nav.projects")} data-project-filters>
            <button type="button" class="filter-pill is-active" data-filter="*" aria-pressed="true">
              {allLabel}
            </button>
            {filterCats.map((category) => (
              <button type="button" class="filter-pill" data-filter={category.key} aria-pressed="false">
                {categoryLabel(category.key, lang)}
              </button>
            ))}
            <span class="filter-count" data-filter-count aria-live="polite" />
          </div>
        )
      }
      <div
        class="grid grid--3"
        data-reveal-group
        data-project-grid
        data-count-one={t("projects.countOne")}
        data-count-many={t("projects.countMany")}
      >
        {
          gridProjects.map((project) => (
            <ProjectCard
              project={project}
              href={project.data.links.github ?? localePath(lang, `/projects/${slugOf(project.id)}`)}
              repoKey={repoKey(project.data.links.github)}
              hidden={Boolean(project.data.links.github) && project.id === featured?.id}
            />
          ))
        }
      </div>
      <p class="proj-empty" data-project-empty hidden>
        {lang === "it" ? "Nessun progetto per questo filtro." : "No projects for this filter."}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-featured {
    margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.6rem);
  }
  .proj-filters {
    position: sticky;
    top: 3.5rem;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    padding-block: 0.75rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(8px);
  }
  .filter-pill {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 550;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .filter-pill:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .filter-pill.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .filter-count {
    margin-left: auto;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .proj-empty {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
  }
  :global(.project-card.is-hidden) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.project-card.is-moving) {
      transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(.project-card.is-entering) {
      animation: cardIn 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes cardIn {
      from { opacity: 0; transform: scale(0.94); }
      to   { opacity: 1; transform: none; }
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-project-filters]");
  const grid = document.querySelector<HTMLElement>("[data-project-grid]");
  const empty = document.querySelector<HTMLElement>("[data-project-empty]");
  const countEl = document.querySelector<HTMLElement>("[data-filter-count]");
  const featuredRoot = document.querySelector<HTMLElement>("[data-pinned-feature]");

  if (grid) {
    const pills = root ? Array.from(root.querySelectorAll<HTMLButtonElement>(".filter-pill")) : [];
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".project-card"));
    const featuredCandidates = featuredRoot
      ? Array.from(featuredRoot.querySelectorAll<HTMLElement>("[data-featured-repo]"))
      : [];
    const countOne = grid.dataset.countOne ?? "";
    const countMany = grid.dataset.countMany ?? "";
    let activeFilter = "*";

    const setCount = (n: number) => {
      if (!countEl) return;
      countEl.textContent = n === 1 ? countOne : countMany.replace("{n}", String(n));
    };

    const applyVisibility = () => {
      let visible = 0;
      cards.forEach((card) => {
        const pinHidden = card.dataset.pinHidden === "true";
        const promoted = card.dataset.promoted === "true";
        const categoryMatch = activeFilter === "*" || card.dataset.category === activeFilter;
        const show = !pinHidden && !promoted && categoryMatch;
        card.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
      setCount(visible);
    };

    const syncPinnedOrder = async () => {
      try {
        const response = await fetch(`/api/github-pinned?t=${Date.now()}`, {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!response.ok) return;

        const payload = (await response.json()) as {
          repositories?: Array<{ name: string }>;
        };
        const order = (payload.repositories ?? []).map((repo) => repo.name.toLowerCase());
        if (!order.length) return;

        const publicCards = cards.filter((card) => Boolean(card.dataset.githubRepo));
        const byRepo = new Map(publicCards.map((card) => [card.dataset.githubRepo!, card]));
        const matchedOrder = order.filter((key) => byRepo.has(key));
        if (!matchedOrder.length) return;

        const first = matchedOrder[0];

        featuredCandidates.forEach((candidate) => {
          candidate.hidden = candidate.dataset.featuredRepo !== first;
        });

        publicCards.forEach((card) => {
          const key = card.dataset.githubRepo!;
          card.dataset.promoted = String(key === first);
          card.dataset.pinHidden = String(!matchedOrder.includes(key));
        });

        matchedOrder.slice(1).forEach((key) => {
          const card = byRepo.get(key);
          if (card) grid.append(card);
        });

        cards
          .filter((card) => !card.dataset.githubRepo)
          .forEach((card) => grid.append(card));

        applyVisibility();
      } catch {
        applyVisibility();
      }
    };

    if (root) {
      root.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-pill");
        if (!button) return;
        activeFilter = button.dataset.filter ?? "*";
        pills.forEach((pill) => {
          const active = pill === button;
          pill.classList.toggle("is-active", active);
          pill.setAttribute("aria-pressed", String(active));
        });
        applyVisibility();
      });
    }

    applyVisibility();
    void syncPinnedOrder();
  }
</script>
