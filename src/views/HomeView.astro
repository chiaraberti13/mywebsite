---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Aptitude from "@/components/Aptitude.astro";
import Skills from "@/components/Skills.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Stats from "@/components/Stats.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations, localePath } from "@/i18n/ui";
import { getFeaturedProjects, slugOf } from "@/lib/content";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = (await getFeaturedProjects(lang)).slice(0, 3);
/* Tutte le credenziali, non più le prime tre: la home ne tagliava due
   (Pre Security e PHP Developer Fundamentals) rispetto all'elenco completo
   del CV e della pagina Certificazioni. */
const certificates = content[lang].curriculum.certifications.items;
const desc = content[lang].hero.subheadline;
---
<BaseLayout lang={lang} title={site.name} description={desc}>
  <Hero lang={lang} />
  <div class="hr container"></div>

  <section class="section section--proof" aria-label={lang === "it" ? "Risultati principali" : "Key results"}>
    <div class="container" data-reveal>
      <Stats lang={lang} />
    </div>
  </section>

  <About lang={lang} />

  <Aptitude lang={lang} />

  <section class="section section--tight values-section" id="values">
    <div class="container values-layout">
      <div class="values-aside">
        <SectionHeader title={t("section.values")} />
      </div>
      <div class="card values-panel" data-reveal>
        <div class="stack values-text">
          {content[lang].values.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <div class="band">
    <Skills lang={lang} />
  </div>


  {
    featured.length > 0 && (
      <section class="section band">
        <div class="container">
          <SectionHeader title={t("section.projects")} />
          <div class="grid grid--3" data-reveal-group>
            {featured.map((p) => (
              <ProjectCard
                project={p}
                href={localePath(lang, `/projects/${slugOf(p.id)}`)}
              />
            ))}
          </div>
          <p class="see-all">
            <a class="btn btn--ghost" href={localePath(lang, "/projects")}>
              {t("cta.viewProjects")}
              <Icon name="chevronRight" size={18} />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section credentials-section">
    <div class="container">
      <SectionHeader
        title={t("section.certifications")}
        intro={lang === "it"
          ? "Credenziali verificate che consolidano il percorso tra sistemi, sviluppo e cybersecurity."
          : "Verified credentials supporting my path across systems, development and cybersecurity."}
      />
      <div class="credential-grid" data-reveal-group>
        {certificates.map((certificate) => (
          <article class="card credential-card">
            <span class="credential-icon" aria-hidden="true">
              <Icon name={certificate.icon ?? "shieldCheck"} size={20} />
            </span>
            <div>
              <p class="credential-year">{certificate.year}</p>
              <h3>{certificate.title}</h3>
              <p class="muted credential-org">{certificate.org}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="see-all">
        <a class="btn btn--ghost" href={localePath(lang, "/certificazioni")}>
          {t("nav.certifications")}
          <Icon name="chevronRight" size={18} />
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-band" data-reveal>
        <div>
          <h2 class="cta-title">{t("section.contact")}</h2>
          <p class="muted">{t("contact.orEmail")} <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <a class="btn btn--primary" href={localePath(lang, "/contact")}>
          {t("cta.contact")}
          <Icon name="chevronRight" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Alternanza di sfondo per dare respiro tra le sezioni della home.
     surface-2 è un neutro leggermente più caldo del bg: crea ritmo restando
     discreto, e fa risaltare le card (che usano --surface).
     I bordi sfumano invece di tagliare netto: lo stacco duro faceva
     percepire le sezioni come blocchi impilati. */
  .section--proof {
    padding-block: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }
  .band {
    position: relative;
    background: var(--surface-2);
  }
  .band::before,
  .band::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 3.5rem;
    pointer-events: none;
  }
  .band::before {
    top: 0;
    background: linear-gradient(to bottom, var(--bg), transparent);
  }
  .band::after {
    bottom: 0;
    background: linear-gradient(to top, var(--bg), transparent);
  }
  .values-section {
    position: relative;
    overflow: hidden;
  }
  .values-section::before {
    content: "";
    position: absolute;
    inset: 12% auto auto 0;
    width: min(22rem, 55vw);
    height: min(22rem, 55vw);
    border-radius: 999px;
    background: radial-gradient(circle, var(--accent-soft), transparent 68%);
    transform: translateX(-42%);
    pointer-events: none;
  }
  .values-layout {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 4vw, 4rem);
  }
  .values-panel {
    position: relative;
    padding: clamp(1.35rem, 1rem + 2vw, 2.3rem);
  }
  .values-text {
    max-width: 62ch;
  }
  @media (min-width: 860px) {
    .values-layout {
      grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1fr);
      align-items: start;
    }
    /* Sticky sull'intera colonna (header + statistiche): prima era sticky
       solo il titolo e sotto restava un grande vuoto. */
    .values-aside {
      position: sticky;
      top: 6rem;
    }
    .values-aside :global(.section-header) {
      margin-bottom: 0;
    }
    .values-panel {
      margin-top: 0.25rem;
    }
  }
  .see-all {
    margin-top: 2rem;
  }
  .credentials-section {
    background: var(--surface-2);
  }
  .credential-grid {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.5vw, 1.5rem);
  }
  @media (min-width: 620px) {
    .credential-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Tre colonne, non quattro: con cinque credenziali le quattro colonne
     riempivano meglio la riga ma stringevano le card a ~240px, spezzando
     "CompTIA Security+ (SY0-701)" su tre righe e il titolo del Certiport
     su quattro. Meglio una riga da 3 + 2 con i titoli leggibili. */
  @media (min-width: 900px) {
    .credential-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .credential-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    /* Righe di pari altezza anche se un titolo va a capo. */
    height: 100%;
  }
  .credential-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .credential-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .credential-card h3 {
    font-size: var(--step-0);
  }
  .credential-org {
    margin-top: 0.25rem;
    font-size: 0.9rem;
  }
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
  }
  .cta-title {
    font-size: var(--step-2);
  }
  .cta-mail {
    color: var(--accent-text);
  }
  .cta-mail:hover {
    text-decoration: underline;
  }
</style>
