---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import About from "@/components/About.astro";
import Skills from "@/components/Skills.astro";
import Aptitude from "@/components/Aptitude.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Stats from "@/components/Stats.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations, localePath } from "@/i18n/ui";
import { getFeaturedProjects, slugOf } from "@/lib/content";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = await getFeaturedProjects(lang);
const desc = content[lang].hero.subheadline;
---
<BaseLayout lang={lang} title={site.name} description={desc}>
  <Hero lang={lang} />
  <div class="hr container"></div>
  <About lang={lang} />

  <section class="section section--tight values-section" id="values">
    <div class="container values-layout">
      <div class="values-aside">
        <SectionHeader eyebrow={t("nav.values")} title={t("section.values")} />
        <div class="values-stats" data-reveal>
          <Stats lang={lang} />
        </div>
      </div>
      <div class="values-panel" data-reveal>
        <div class="stack values-text">
          {content[lang].values.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <div class="band">
    <Skills lang={lang} />
  </div>

  <Aptitude lang={lang} />

  {
    featured.length > 0 && (
      <section class="section band">
        <div class="container">
          <SectionHeader eyebrow={t("nav.projects")} title={t("section.projects")} />
          <div class="grid grid--3" data-reveal-group>
            {featured.map((p) => (
              <ProjectCard
                project={p}
                href={localePath(lang, `/projects/${slugOf(p.id)}`)}
              />
            ))}
          </div>
          <p class="see-all">
            <a class="btn btn--ghost" href={localePath(lang, "/projects")}>
              {t("cta.viewProjects")}
              <Icon name="chevronRight" size={18} />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <div>
          <h2 class="cta-title">{t("section.contact")}</h2>
          <p class="muted">{t("contact.orEmail")} <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <a class="btn btn--primary" href={localePath(lang, "/contact")}>
          {t("cta.contact")}
          <Icon name="chevronRight" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Alternanza di sfondo per dare respiro tra le sezioni della home.
     surface-2 è un neutro leggermente più caldo del bg: crea ritmo restando
     discreto, e fa risaltare le card (che usano --surface).
     I bordi sfumano invece di tagliare netto: lo stacco duro faceva
     percepire le sezioni come blocchi impilati. */
  .band {
    position: relative;
    background: var(--surface-2);
  }
  .band::before,
  .band::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 3.5rem;
    pointer-events: none;
  }
  .band::before {
    top: 0;
    background: linear-gradient(to bottom, var(--bg), transparent);
  }
  .band::after {
    bottom: 0;
    background: linear-gradient(to top, var(--bg), transparent);
  }
  .values-section {
    position: relative;
    overflow: hidden;
  }
  .values-section::before {
    content: "";
    position: absolute;
    inset: 12% auto auto 0;
    width: min(22rem, 55vw);
    height: min(22rem, 55vw);
    border-radius: 999px;
    background: radial-gradient(circle, var(--accent-soft), transparent 68%);
    transform: translateX(-42%);
    pointer-events: none;
  }
  .values-layout {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 1rem + 4vw, 4rem);
  }
  .values-panel {
    position: relative;
    padding: clamp(1.35rem, 1rem + 2vw, 2.3rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--surface), var(--surface-2));
    box-shadow: var(--shadow);
  }
  .values-panel::before {
    content: "";
    position: absolute;
    inset-block: clamp(1.35rem, 1rem + 2vw, 2.3rem);
    left: 0;
    width: 3px;
    border-radius: 999px;
    background: var(--accent);
  }
  .values-text {
    max-width: 62ch;
  }
  .values-stats {
    margin-top: 1.75rem;
  }
  @media (min-width: 860px) {
    .values-layout {
      grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1fr);
      align-items: start;
    }
    /* Sticky sull'intera colonna (header + statistiche): prima era sticky
       solo il titolo e sotto restava un grande vuoto. */
    .values-aside {
      position: sticky;
      top: 6rem;
    }
    .values-aside :global(.section-header) {
      margin-bottom: 0;
    }
    .values-panel {
      margin-top: 0.25rem;
    }
  }
  .see-all {
    margin-top: 2rem;
  }
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .cta-title {
    font-size: var(--step-2);
  }
  .cta-mail {
    color: var(--accent);
  }
  .cta-mail:hover {
    text-decoration: underline;
  }
</style>
