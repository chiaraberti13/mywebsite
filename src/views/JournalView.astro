---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";
import { type Locale } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";
import { getJournal, slugOf } from "@/lib/content";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getJournal(lang);
const desc =
  lang === "it"
    ? "Articoli e note su cybersecurity, ethical hacking e tecnologia."
    : "Articles and notes on cybersecurity, ethical hacking and technology.";
const locale = lang === "it" ? "it-IT" : "en-US";
---
<BaseLayout lang={lang} title={t("nav.journal")} description={desc}>
  <section class="section">
    <div class="container">
      <SectionHeader title={t("section.journal")} level="h1" />
      <ul class="post-grid grid grid--2" role="list" data-reveal-group>
        {
          posts.map((post) => (
            <li>
              <a class="post card card--link" href={localePath(lang, `/journal/${slugOf(post.id)}`)}>
                <p class="post-date">
                  {post.data.date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h3 class="post-title">{post.data.title}</h3>
                <p class="muted post-desc">{post.data.description}</p>
                {
                  post.data.tags.length > 0 && (
                    <ul class="post-tags" role="list">
                      {post.data.tags.slice(0, 4).map((tag) => (
                        <li class="tag tag--neutral">{tag}</li>
                      ))}
                    </ul>
                  )
                }
                <span class="post-more">{t("cta.readMore")} <Icon name="chevronRight" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-left: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    overflow: hidden;
  }
  /* Linea accent laterale */
  .post::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--accent);
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .post:hover::before {
    opacity: 1;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-text);
    letter-spacing: 0.02em;
    margin-bottom: 0.6rem;
  }
  .post-title {
    font-size: var(--step-1);
  }
  .post-desc {
    margin: 0.5rem 0 0.9rem;
    max-width: 62ch;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .post-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
