---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Icon from "@/components/Icon.astro";
import { site, type Locale } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const cur = content[lang].curriculum;
const desc =
  lang === "it"
    ? "Formazione di Chiara Berti: il percorso dal design alla cybersecurity e l'istruzione."
    : "Chiara Berti's education: the path from design to cybersecurity and academic background.";
---
<BaseLayout lang={lang} title={t("nav.education")} description={desc}>
  <section class="section" id="percorso">
    <div class="container">
      <div class="cv-head">
        <SectionHeader eyebrow={t("nav.education")} title={t("section.path")} level="h1" />
        {
          site.features.cvDownload && (
            <a class="btn btn--primary" href={site.cvFile} download>
              <Icon name="download" size={18} />
              {t("cta.downloadCv")}
            </a>
          )
        }
      </div>
      <div class="stack cv-intro" data-reveal>
        {cur.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="istruzione">
    <div class="container">
      <SectionHeader title={t("section.education")} intro={cur.education.lead} />
      <ol class="edu-timeline" role="list" data-reveal-group>
        {
          cur.education.items.map((ed) => (
            <li class="edu-item">
              <span class="edu-marker" aria-hidden="true" />
              <div class="card cv-block">
                {ed.period && <p class="cv-period">{ed.period}</p>}
                <h3 class="cv-block-title">{ed.title}</h3>
                <p class="cv-org">{ed.org}</p>
                {ed.description && <p class="muted">{ed.description}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cv-intro {
    max-width: 65ch;
  }
  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.4rem;
    display: inline-block;
  }
  .cv-block-title {
    font-size: var(--step-1);
  }
  .cv-org {
    color: var(--accent-text);
    font-weight: 550;
    margin: 0.15rem 0 0.6rem;
  }

  /* Timeline verticale (coerente con Esperienze) */
  .edu-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .edu-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1.5rem;
  }
  .edu-item::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.4rem;
    bottom: -0.4rem;
    width: 2px;
    background: var(--border);
  }
  .edu-item:last-child::before {
    display: none;
  }
  .edu-marker {
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
    z-index: 1;
  }
</style>
