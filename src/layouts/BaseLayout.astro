---
// Font tech self-hostati (serviti dallo stesso dominio -> compatibili con la CSP font-src 'self').
// fonts.css dichiara SOLO i subset latino e latino esteso: i 5 file
// cirillico/greco/vietnamita del pacchetto Fontsource non servono a un sito
// IT/EN e uscivano comunque dalla build.
import "@/styles/fonts.css";
import "@/styles/global.css";

// URL (con hash di cache-busting) dei due file font che servono SUBITO, per
// il preload in <head>. Senza preload il browser li scopre solo dopo aver
// scaricato e interpretato il CSS: il testo appare prima con il font di
// sistema e poi "salta" a quello giusto (FOUT).
import sansLatin from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import { site } from "@/config/site";
import { jsonLd } from "@/lib/jsonld";
import type { Locale } from "@/config/site";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Immagine social opzionale (percorso assoluto in /public) */
  image?: string;
  noindex?: boolean;
}
const { title, description, lang, image = "/og-default.png", noindex = false } =
  Astro.props;

// URL canonico + alternate hreflang per la stessa pagina nelle due lingue
const path = Astro.url.pathname;
const itPath = lang === "it" ? path : (path.replace(/^\/en/, "") || "/");
const enPath = lang === "en" ? path : path === "/" ? "/en/" : `/en${path}`;
const canonical = new URL(path, site.url).href;
const itUrl = new URL(itPath, site.url).href;
const enUrl = new URL(enPath, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle =
  title === site.name
    ? `${site.name} — Automation Developer & Cybersecurity`
    : `${title} · ${site.name}`;

// I due colori della barra del browser viaggiano come attributi `data-` su
// <html> (vedi sotto): da lì li leggono sia lo script che imposta il tema
// prima del primo disegno, sia il pulsante di cambio tema. Un solo punto di
// verità (site.ts), nessun colore ripetuto a mano dentro il JavaScript.
//
// NB: quella spiegazione NON può stare come commento {/* */} fra <!doctype>
// e <html>. Il compilatore di Astro interpreta un'espressione in quella
// posizione come inizio del contenuto del documento e scarta l'elemento
// <html>: la pagina esce senza tag radice e quindi senza attributo `lang`
// — con danno immediato a SEO e screen reader.

// Dati strutturati: aiutano i motori di ricerca a capire di chi è il sito.
// Tutti i valori vengono da site.ts, nessun dato inventato.
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: "Automation Developer",
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Latina",
    addressCountry: "IT",
  },
  knowsAbout: [
    "Process automation",
    "Python",
    "Bash",
    "Linux",
    "Cybersecurity",
    "Networking",
  ],
  sameAs: site.socials.map((s) => s.url),
};
---
<!doctype html>
<html
  lang={lang}
  data-theme="light"
  data-bar-light={site.themeColor.light}
  data-bar-dark={site.themeColor.dark}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* Un solo theme-color ocra tingeva di giallo la barra del browser anche
        in tema scuro. Ora ogni tema tinge la barra del proprio colore di
        sfondo: l'interfaccia del telefono si fonde con la pagina.

        Le due varianti `media` coprono il caso "nessuna scelta esplicita":
        la barra segue il sistema operativo. Quando invece l'utente sceglie a
        mano il tema con il pulsante, quelle media query non c'entrano piu'
        nulla e la barra restava del colore sbagliato (fondo chiaro con sito
        scuro). Lo script qui sotto, e il pulsante, riscrivono allora il
        `content` di entrambi i meta con il colore del tema attivo. */}
    <meta name="theme-color" content={site.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={site.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#d7a521" />

    {/* Preload dei due font sopra la piega. `crossorigin` è obbligatorio
        anche per font serviti dal proprio dominio: senza, il browser
        considera il preload una risorsa diversa e scarica il file due volte. */}
    <link rel="preload" as="font" type="font/woff2" href={sansLatin} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin="anonymous" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={itUrl} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={jsonLd(personLd)} />

    <!-- Imposta il tema prima del paint per evitare il flash (CSP: hash whitelisted) -->
    <script is:inline>(function(){var r=document.documentElement;function bar(t){var c=t==="dark"?r.dataset.barDark:r.dataset.barLight;if(!c)return;var m=document.querySelectorAll('meta[name="theme-color"]');for(var i=0;i<m.length;i++)m[i].setAttribute("content",c)}try{var t=localStorage.getItem("theme");if(t==="dark"||t==="light"){r.dataset.theme=t;bar(t);return}}catch(e){}r.dataset.theme=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"})();</script>
    <!-- Abilita lo stato iniziale delle animazioni di reveal solo con JS.
         Il timer e' la rete di sicurezza per il caso peggiore: se il modulo
         che gestisce le animazioni non arriva mai (rete lenta, errore di
         caricamento), il contenuto non deve restare invisibile. Il modulo,
         appena parte, alza il flag e disinnesca il timer. -->
    <script is:inline>document.documentElement.classList.add("reveal-ready");setTimeout(function(){if(!window.__reveal)document.documentElement.classList.remove("reveal-ready")},2500);</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "it" ? "Vai al contenuto" : "Skip to content"}</a>
    <div class="read-progress" aria-hidden="true"><span></span></div>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Segnala allo script inline in <head> che il modulo e' vivo: la sua
      // rete di sicurezza a 2,5s non deve scattare.
      window.__reveal = true;

      const els = document.querySelectorAll("[data-reveal],[data-reveal-group]");
      if ("IntersectionObserver" in window && els.length) {
        // `fired` distingue "l'osservatore funziona" da "non e' mai partito".
        // Un IntersectionObserver invoca SEMPRE la propria callback una prima
        // volta subito dopo observe(), anche quando nessun elemento interseca:
        // se quella chiamata non arriva, l'osservatore e' inerte.
        let fired = false;
        const io = new IntersectionObserver(
          (entries, obs) => {
            fired = true;
            for (const e of entries) {
              // `isIntersecting`: il blocco e' entrato nello schermo, si
              // rivela — il caso normale.
              //
              // `boundingClientRect.bottom <= 0`: il blocco e' GIA' sopra lo
              // schermo, cioe' e' stato oltrepassato senza passare davanti
              // agli occhi. Succede quando il salto e' istantaneo e non
              // graduale: si apre un link con ancora (/#skills), si ricarica
              // una pagina che il browser riporta a meta' altezza, si torna
              // indietro nella cronologia. In quei casi l'osservatore non
              // vede mai un'intersezione e tutto cio' che sta sopra
              // resterebbe a opacita' zero: contenuto perso finche' non si
              // risale. Qui viene semplicemente mostrato, senza animazione
              // d'ingresso — che per un blocco gia' superato non avrebbe
              // comunque senso.
              if (e.isIntersecting || e.boundingClientRect.bottom <= 0) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            }
          },
          // threshold 0 + margine inferiore negativo: l'elemento si rivela
          // appena entra nel 90% basso dello schermo, qualunque sia la sua
          // altezza. Con una soglia percentuale un blocco molto piu' alto
          // del viewport poteva non raggiungerla mai e restare invisibile.
          { threshold: 0, rootMargin: "0px 0px -10% 0px" },
        );
        els.forEach((el) => io.observe(el));

        // Rete di sicurezza CONDIZIONATA. Prima questo timer rimuoveva
        // `reveal-ready` sempre: dopo 3 secondi dal caricamento tutte le
        // animazioni d'ingresso sparivano: chi restava sul hero piu' di tre
        // secondi (cioe' chiunque) e poi scorreva non ne vedeva nemmeno una.
        // Ora scatta solo se l'osservatore e' davvero inerte.
        window.setTimeout(() => {
          if (!fired) document.documentElement.classList.remove("reveal-ready");
        }, 3000);
      } else {
        document.documentElement.classList.remove("reveal-ready");
      }

      // Barra di lettura: solo se il browser non supporta scroll-timeline
      // (dove è supportata l'animazione è gestita interamente dalla CSS).
      const bar = document.querySelector<HTMLElement>(".read-progress > span");
      const nativeTimeline =
        typeof CSS !== "undefined" && CSS.supports("animation-timeline: scroll()");
      if (bar && !nativeTimeline) {
        let ticking = false;
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? window.scrollY / max : 0;
          bar.style.setProperty("--read", String(Math.min(1, Math.max(0, ratio))));
          ticking = false;
        };
        update();
        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        window.addEventListener("resize", update);
      }
    </script>
  </body>
</html>
