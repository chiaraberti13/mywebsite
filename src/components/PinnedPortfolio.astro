---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/config/site";
import { localePath } from "@/i18n/ui";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Locale;
  mode?: "home" | "projects";
  limit?: number;
  professional?: CollectionEntry<"projects">[];
}

const {
  lang,
  mode = "projects",
  limit = mode === "home" ? 3 : 6,
  professional = [],
} = Astro.props;

const allLabel = lang === "it" ? "Tutte" : "All";
const loading = lang === "it" ? "Caricamento progetti…" : "Loading projects…";
const unavailable =
  lang === "it"
    ? "I progetti non sono disponibili in questo momento."
    : "Projects are temporarily unavailable.";
const countOne = lang === "it" ? "1 progetto" : "1 project";
const countMany = lang === "it" ? "{n} progetti" : "{n} projects";
const featuredLabel = lang === "it" ? "In evidenza" : "Featured";
const openRepo = lang === "it" ? "Apri repository" : "Open repository";
const categoryLabels = {
  cybersecurity: { it: "Cybersecurity", en: "Cybersecurity" },
  "interactive-labs": { it: "Laboratori interattivi", en: "Interactive labs" },
  "sdr-radio": { it: "SDR e radio", en: "SDR & radio" },
  "automation-utilities": { it: "Automazione e utility", en: "Automation & utilities" },
  "professional-work": { it: "Progetti professionali", en: "Professional work" },
};
---
<div
  class:list={["pinned-portfolio", { "is-home": mode === "home" }]}
  data-pinned-portfolio
  data-mode={mode}
  data-limit={limit}
  data-lang={lang}
  data-loading={loading}
  data-unavailable={unavailable}
  data-count-one={countOne}
  data-count-many={countMany}
  data-all-label={allLabel}
  data-featured-label={featuredLabel}
  data-open-repo={openRepo}
  data-label-cybersecurity={categoryLabels.cybersecurity[lang]}
  data-label-interactive-labs={categoryLabels["interactive-labs"][lang]}
  data-label-sdr-radio={categoryLabels["sdr-radio"][lang]}
  data-label-automation-utilities={categoryLabels["automation-utilities"][lang]}
  data-label-professional-work={categoryLabels["professional-work"][lang]}
>
  {
    mode === "projects" && (
      <div class="projects-featured" data-pinned-feature>
        <p class="pinned-state muted" role="status">{loading}</p>
      </div>
    )
  }

  {
    mode === "projects" && (
      <div class="proj-filters" role="group" aria-label={lang === "it" ? "Filtra progetti" : "Filter projects"} data-project-filters hidden>
        <span class="filter-count" data-filter-count aria-live="polite" />
      </div>
    )
  }

  <div
    class="grid grid--3"
    data-project-grid
    data-reveal-group
  >
    {
      mode === "projects" &&
      professional.map((project) => (
        <ProjectCard
          project={project}
          href={localePath(lang, `/projects/${project.id.split("/").pop()}`)}
        />
      ))
    }
    <p class="pinned-state muted" data-grid-loading role="status">{loading}</p>
  </div>

  {
    mode === "projects" && (
      <p class="proj-empty" data-project-empty hidden>
        {lang === "it" ? "Nessun progetto per questo filtro." : "No projects for this filter."}
      </p>
    )
  }
</div>

<style>
  .projects-featured {
    margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.6rem);
  }
  .pinned-state {
    grid-column: 1 / -1;
    margin: 0;
    padding: 1.25rem 0;
    text-align: center;
  }
  .proj-filters {
    position: sticky;
    top: 3.5rem;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    padding-block: 0.75rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(8px);
  }
  .filter-count {
    margin-left: auto;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .proj-empty {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
  }

  :global(.filter-pill) {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 550;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  :global(.filter-pill:hover) {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  :global(.filter-pill.is-active) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  /* Layout identico al vecchio ProjectFeatured. */
  :global(.pinned-featured) {
    position: relative;
    display: grid;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  @media (min-width: 820px) {
    :global(.pinned-featured) {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
    }
  }
  :global(.pinned-featured-cover) {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  @media (min-width: 820px) {
    :global(.pinned-featured-cover) {
      border-bottom: 0;
      border-inline-end: 1px solid var(--border);
    }
    :global(.pinned-featured-cover .project-cover) {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
    }
  }
  :global(.pinned-featured-body) {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
  }
  :global(.pinned-featured-eyebrow) {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.45rem;
    width: fit-content;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  :global(.pinned-featured-title) {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  :global(.pinned-featured-title a) {
    color: inherit;
    text-decoration: none;
  }
  :global(.pinned-featured-summary) {
    color: var(--muted);
    max-width: 52ch;
    margin: 0;
  }
  :global(.pinned-featured-tags),
  :global(.dynamic-project-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
  }
  :global(.pinned-featured-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  /* Card dinamiche con lo stesso DOM/CSS delle vecchie ProjectCard. */
  :global(.dynamic-project-card) {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  :global(.dynamic-project-card[hidden]) {
    display: none !important;
  }
  :global(.dynamic-project-card .project-cover-link) {
    position: relative;
    display: block;
    overflow: hidden;
  }
  :global(.dynamic-project-card .project-cover-arrow) {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 4;
  }
  :global(.dynamic-project-card:hover .project-cover-arrow),
  :global(.dynamic-project-card:focus-within .project-cover-arrow) {
    opacity: 1;
    transform: translateY(0);
  }
  :global(.dynamic-project-card .project-body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.2rem, 1rem + 1vw, 1.6rem);
  }
  :global(.dynamic-project-card .project-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.dynamic-project-card .project-category) {
    width: fit-content;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }
  :global(.dynamic-project-card .project-title) {
    margin: 0;
    font-size: var(--step-1);
  }
  :global(.dynamic-project-card .project-title a) {
    color: inherit;
    text-decoration: none;
  }
  :global(.dynamic-project-card .project-summary) {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  :global(.dynamic-project-card .project-more) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 0.15rem;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Copertina generata: stessa geometria e linguaggio del ProjectCover originale. */
  :global(.project-cover) {
    position: relative;
    display: block;
    aspect-ratio: 21 / 9;
    background: var(--surface-2);
    overflow: hidden;
  }
  :global(.project-cover.is-large) {
    aspect-ratio: 16 / 10;
  }
  :global(.project-cover--gen) {
    background: linear-gradient(150deg, var(--surface-2) 0%, var(--surface) 55%, var(--surface-2) 100%);
    color: var(--accent-line);
  }
  :global(.cov-blob) {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: 72%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 68%);
  }
  :global(.cov-grid) {
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0.12;
  }
  :global(.cov-cat--cybersecurity .cov-grid) {
    background-image:
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 26px 26px;
  }
  :global(.cov-cat--interactive-labs .cov-grid) {
    background-image: radial-gradient(currentColor 1.5px, transparent 1.6px);
    background-size: 20px 20px;
  }
  :global(.cov-cat--sdr-radio .cov-grid) {
    background-image: repeating-radial-gradient(circle at 50% 50%, currentColor 0 1px, transparent 1px 22px);
  }
  :global(.cov-cat--automation-utilities .cov-grid) {
    background-image: repeating-linear-gradient(-45deg, currentColor 0 1px, transparent 1px 14px);
  }
  :global(.cov-glyph) {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-line);
    opacity: 0.94;
  }
  :global(.cov-glyph::before) {
    content: "";
    position: absolute;
    width: clamp(5.6rem, 31cqi, 8.8rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent-line) 26%, transparent);
    border-radius: 30%;
    transform: rotate(45deg);
    opacity: 0.52;
  }
  :global(.cov-glyph::after) {
    content: "";
    position: absolute;
    width: clamp(7.4rem, 40cqi, 11.6rem);
    aspect-ratio: 1;
    border: 1px dashed color-mix(in srgb, var(--accent-line) 18%, transparent);
    border-radius: 50%;
    opacity: 0.48;
  }
  :global(.cov-glyph svg) {
    position: relative;
    z-index: 2;
    width: clamp(4.4rem, 24cqi, 7.1rem);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 8px 18px var(--accent-soft));
  }
  :global(.project-cover.is-large .cov-glyph svg) {
    width: clamp(5.8rem, 22cqi, 9.6rem);
  }
  :global(.cov-glyph .icon-soft) {
    opacity: 0.42;
  }
  :global(.cov-glyph .icon-accent) {
    stroke-width: 2.15;
  }
  :global(.cov-glyph .icon-node) {
    fill: var(--surface);
    stroke-width: 1.8;
  }
  :global(.cov-glyph--signal::after),
  :global(.cov-glyph--radio-decoder::after) {
    transform: scaleX(1.18);
  }
  :global(.cov-glyph--honeypot::before),
  :global(.cov-glyph--observability::before) {
    border-radius: 50%;
  }
</style>

<script>
  type Category =
    | "cybersecurity"
    | "interactive-labs"
    | "sdr-radio"
    | "automation-utilities"
    | "professional-work";

  type Repo = {
    name: string;
    description: string | null;
    url: string;
    homepage: string | null;
    language: string | null;
    stars: number;
    forks: number;
    topics: string[];
    category: Category;
  };

  const makeText = (tag: string, className: string, value: string) => {
    const el = document.createElement(tag);
    el.className = className;
    el.textContent = value;
    return el;
  };

  type VisualKey =
    | "honeypot"
    | "topology"
    | "exam-matrix"
    | "observability"
    | "spectrum"
    | "signal"
    | "ear-signal"
    | "radio-decoder"
    | "workflow-forge"
    | "document-pipeline"
    | "configurator"
    | "document-check"
    | "code-document"
    | "browser-code"
    | "cyber-core"
    | "automation-core";

  const SVG_NS = "http://www.w3.org/2000/svg";

  const ICON_MARKUP: Record<VisualKey, string> = {
    honeypot: `
      <path class="icon-soft" d="M12 3.2c3.9 0 7.2 1.8 9.2 4.7-2 2.9-5.3 4.7-9.2 4.7S4.8 10.8 2.8 7.9C4.8 5 8.1 3.2 12 3.2Z"/>
      <circle class="icon-node" cx="12" cy="7.9" r="2.1"/>
      <path class="icon-accent" d="M12 11.2v3.2m0 0-3.6 2.1m3.6-2.1 3.6 2.1"/>
      <circle class="icon-node" cx="8.4" cy="16.5" r="1.5"/>
      <circle class="icon-node" cx="15.6" cy="16.5" r="1.5"/>
      <path class="icon-soft" d="M6 20.4h12M4.3 22h15.4"/>
    `,
    topology: `
      <path class="icon-soft" d="M4 6.4 12 2l8 4.4-8 4.4L4 6.4Zm0 5 8 4.4 8-4.4M4 16.4l8 4.4 8-4.4"/>
      <circle class="icon-node" cx="4" cy="6.4" r="1.25"/>
      <circle class="icon-node" cx="12" cy="2" r="1.25"/>
      <circle class="icon-node" cx="20" cy="6.4" r="1.25"/>
      <circle class="icon-node" cx="12" cy="10.8" r="1.25"/>
      <path class="icon-accent" d="M8.2 13.7 12 11.6l3.8 2.1"/>
    `,
    "exam-matrix": `
      <rect class="icon-soft" x="3" y="3" width="18" height="18" rx="3"/>
      <path d="M7 8h3M7 12h3M7 16h3M14 8h3M14 12h3"/>
      <path class="icon-accent" d="m13.6 16 1.7 1.7 3.5-4"/>
      <circle class="icon-node" cx="8.5" cy="8" r=".8"/>
      <circle class="icon-node" cx="15.5" cy="8" r=".8"/>
    `,
    observability: `
      <path class="icon-soft" d="M2.7 12s3.5-5.1 9.3-5.1 9.3 5.1 9.3 5.1-3.5 5.1-9.3 5.1S2.7 12 2.7 12Z"/>
      <circle class="icon-node" cx="12" cy="12" r="2.7"/>
      <path class="icon-accent" d="M12 4V2.2M5.8 5.8 4.5 4.5M18.2 5.8l1.3-1.3M4.2 12H2.3M21.7 12h-1.9"/>
      <path d="M9.7 20.3h4.6"/>
    `,
    spectrum: `
      <path class="icon-soft" d="M3 19h18M5 16v-3m3 3V8m3 8V5m3 11V9m3 7v-5m3 5v-2"/>
      <path class="icon-accent" d="M4 7c2.2-2 4.1-2 6 0s3.8 2 5.7 0 3.6-2 5.3-.5"/>
      <circle class="icon-node" cx="11" cy="5" r="1.2"/>
    `,
    signal: `
      <path class="icon-soft" d="M2.5 12h3l2-5 3.1 10 2.6-7 2.1 4h6.2"/>
      <path class="icon-accent" d="M6.2 5.2a8 8 0 0 1 11.6 0M8.5 7.6a4.8 4.8 0 0 1 7 0"/>
      <circle class="icon-node" cx="12" cy="10.2" r="1.15"/>
      <path d="M12 11.4V20"/>
    `,
    "ear-signal": `
      <path class="icon-accent" d="M14.8 18.2c-1 2.1-2.3 3-4 3-2.7 0-4.6-1.9-4.6-4.5 0-2.1 1-3.3 2.2-4.4 1.5-1.3 2.5-2.4 2.5-4.3 0-2 1.4-3.7 3.6-3.7 2.4 0 4.1 1.8 4.1 4.2"/>
      <path d="M12.4 12.5c.5-.8 1.1-1.3 2-1.3 1.1 0 1.8.8 1.8 1.8 0 1.4-1.4 2-2 3.1"/>
      <path class="icon-soft" d="M18.4 8.1c1.2 1 1.9 2.3 1.9 3.9s-.7 2.9-1.9 3.9M20.6 5.8c1.8 1.7 2.9 3.8 2.9 6.2s-1.1 4.5-2.9 6.2"/>
      <circle class="icon-node" cx="14.4" cy="13" r=".75"/>
    `,
    "radio-decoder": `
      <path class="icon-soft" d="M4 18V9l8-5 8 5v9"/>
      <path class="icon-accent" d="M12 4V1.8M8 11h8M8 14h5"/>
      <rect x="6" y="8" width="12" height="11" rx="2"/>
      <path d="M9 18v2.2m6-2.2v2.2"/>
      <circle class="icon-node" cx="16.2" cy="14.2" r="1.1"/>
    `,
    "workflow-forge": `
      <path class="icon-soft" d="M5 6h5l2 3h7M5 18h5l2-3h7"/>
      <circle class="icon-node" cx="5" cy="6" r="1.5"/>
      <circle class="icon-node" cx="5" cy="18" r="1.5"/>
      <circle class="icon-node" cx="19" cy="9" r="1.5"/>
      <circle class="icon-node" cx="19" cy="15" r="1.5"/>
      <path class="icon-accent" d="M12 9v6m-2-3h4"/>
      <path d="m9.8 4.4 2.2 2.2 2.2-2.2"/>
    `,
    "document-pipeline": `
      <path class="icon-soft" d="M5 3h9l5 5v13H5V3Z"/>
      <path d="M14 3v5h5M8 12h6M8 16h5"/>
      <path class="icon-accent" d="M2 9h3m-1.5-1.5L5 9 3.5 10.5M19 15h3m-1.5-1.5L22 15l-1.5 1.5"/>
    `,
    configurator: `
      <path class="icon-soft" d="M4 6h16M4 12h16M4 18h16"/>
      <circle class="icon-node" cx="9" cy="6" r="2"/>
      <circle class="icon-node" cx="15" cy="12" r="2"/>
      <circle class="icon-node" cx="7" cy="18" r="2"/>
      <path class="icon-accent" d="M9 3v6M15 9v6M7 15v6"/>
    `,
    "document-check": `
      <path class="icon-soft" d="M6 3h8l4 4v14H6V3Z"/>
      <path d="M14 3v5h5M9 12h5M9 16h3"/>
      <path class="icon-accent" d="m13.8 17.2 1.6 1.6 3.2-3.8"/>
    `,
    "code-document": `
      <path class="icon-soft" d="M6 3h8l4 4v14H6V3Z"/>
      <path d="M14 3v5h5"/>
      <path class="icon-accent" d="m11 12-2 2 2 2m3-4 2 2-2 2"/>
      <path d="m13.3 11.2-2.6 5.6"/>
    `,
    "browser-code": `
      <rect class="icon-soft" x="3" y="4" width="18" height="16" rx="2.5"/>
      <path d="M3 8h18M6 6h.01M9 6h.01"/>
      <path class="icon-accent" d="m10 12-2 2 2 2m4-4 2 2-2 2"/>
    `,
    "cyber-core": `
      <path class="icon-soft" d="M12 2.5 19 6v5.5c0 4.5-2.8 7.7-7 10-4.2-2.3-7-5.5-7-10V6l7-3.5Z"/>
      <path class="icon-accent" d="M12 7v10M8 10h8M8.8 15.2l6.4-6.4"/>
      <circle class="icon-node" cx="12" cy="12" r="1.4"/>
    `,
    "automation-core": `
      <circle class="icon-soft" cx="12" cy="12" r="7.5"/>
      <path class="icon-accent" d="M12 4.5V2M12 22v-2.5M4.5 12H2M22 12h-2.5M6.7 6.7 5 5M19 19l-1.7-1.7M17.3 6.7 19 5M5 19l1.7-1.7"/>
      <path d="m9 12 2 2 4-4"/>
    `,
  };

  const resolveVisual = (repo: Repo): VisualKey => {
    const name = repo.name.toLowerCase();
    const haystack = [repo.name, repo.description ?? "", ...(repo.topics ?? [])]
      .join(" ")
      .toLowerCase();

    if (name.includes("aegis-nexus") || /(honeypot|attack map|threat intel|ioc|soc)/.test(haystack)) return "honeypot";
    if (name.includes("osi-cyber-explorer") || /(osi|topology|ccna|network explorer|networking)/.test(haystack)) return "topology";
    if (name.includes("comptia-security") || /(exam|quiz|study|certification|trainer)/.test(haystack)) return "exam-matrix";
    if (name.includes("olympus-security") || /(observability|monitoring|osint|argus)/.test(haystack)) return "observability";
    if (name.includes("rfnm-sdrpp") || /(spectrum|rfnm|sdrpp)/.test(haystack)) return "spectrum";
    if (name === "sdr-plus" || /(waveform|signal chain)/.test(haystack)) return "signal";
    if (name.includes("tetraear")) return "ear-signal";
    if (name.includes("osmotetra") || /(tetra decoder|radio decoder|decoder)/.test(haystack)) return "radio-decoder";
    if (name.includes("utility-forge") || /(forge|workflow|utility suite|toolchain)/.test(haystack)) return "workflow-forge";
    if (name.includes("scheda-tecnica") || /(datasheet|technical sheet|pdf pipeline)/.test(haystack)) return "document-pipeline";
    if (name.includes("configuratore-online") || /(configurator|configuration)/.test(haystack)) return "configurator";
    if (name === "dichiarazioni") return "document-check";
    if (name.includes("dichiarazioni_php")) return "code-document";
    if (name === "mywebsite" || /(portfolio|website|astro)/.test(haystack)) return "browser-code";

    if (repo.category === "cybersecurity") return "cyber-core";
    if (repo.category === "interactive-labs") return "topology";
    if (repo.category === "sdr-radio") return "signal";
    return "automation-core";
  };

  const makeRepoIcon = (repo: Repo) => {
    const visual = resolveVisual(repo);
    const svg = document.createElementNS(SVG_NS, "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("focusable", "false");
    svg.innerHTML = ICON_MARKUP[visual];

    const glyph = document.createElement("span");
    glyph.className = `cov-glyph cov-glyph--${visual}`;
    glyph.append(svg);
    return glyph;
  };

  const makeCover = (repo: Repo, large = false) => {
    const cover = document.createElement("div");
    cover.className = `project-cover project-cover--gen cov-cat--${repo.category}${large ? " is-large" : ""}`;
    const blob = document.createElement("span");
    blob.className = "cov-blob";
    const grid = document.createElement("span");
    grid.className = "cov-grid";
    cover.append(blob, grid, makeRepoIcon(repo));
    return cover;
  };

  document.querySelectorAll<HTMLElement>("[data-pinned-portfolio]").forEach(async (root) => {
    const mode = root.dataset.mode ?? "projects";
    const limit = Math.max(1, Number(root.dataset.limit ?? 6));
    const grid = root.querySelector<HTMLElement>("[data-project-grid]");
    const featuredRoot = root.querySelector<HTMLElement>("[data-pinned-feature]");
    const filterRoot = root.querySelector<HTMLElement>("[data-project-filters]");
    const countEl = root.querySelector<HTMLElement>("[data-filter-count]");
    const emptyEl = root.querySelector<HTMLElement>("[data-project-empty]");
    const loadingEl = root.querySelector<HTMLElement>("[data-grid-loading]");
    if (!grid) return;

    const categoryLabel = (category: Category) => {
      const key = category.replace(/-([a-z])/g, (_, c: string) => c.toUpperCase());
      return root.dataset[`label${key.charAt(0).toUpperCase() + key.slice(1)}`] ?? category;
    };
    const featuredLabel = root.dataset.featuredLabel ?? "Featured";
    const openRepo = root.dataset.openRepo ?? "Open repository";
    const countOne = root.dataset.countOne ?? "1 project";
    const countMany = root.dataset.countMany ?? "{n} projects";
    const allLabel = root.dataset.allLabel ?? "All";
    let activeFilter = "*";

    const makeTags = (repo: Repo, className: string) => {
      const topics = (repo.topics ?? []).slice(0, 5);
      if (!topics.length) return null;
      const list = document.createElement("ul");
      list.className = className;
      topics.forEach((topic) => {
        const li = document.createElement("li");
        li.className = "tag tag--neutral";
        li.textContent = topic;
        list.append(li);
      });
      return list;
    };

    const makeCard = (repo: Repo) => {
      const article = document.createElement("article");
      article.className = "card card--link project-card dynamic-project-card";
      article.dataset.category = repo.category;
      article.dataset.githubRepo = repo.name.toLowerCase();

      const coverLink = document.createElement("a");
      coverLink.className = "project-cover-link";
      coverLink.href = repo.url;
      coverLink.target = "_blank";
      coverLink.rel = "noopener noreferrer";
      coverLink.append(makeCover(repo));
      coverLink.append(makeText("span", "project-cover-arrow", "↗"));

      const body = document.createElement("div");
      body.className = "project-body";
      const meta = document.createElement("div");
      meta.className = "project-meta";
      meta.append(makeText("p", "project-category", categoryLabel(repo.category)));
      body.append(meta);

      const title = document.createElement("h3");
      title.className = "project-title";
      const titleLink = document.createElement("a");
      titleLink.href = repo.url;
      titleLink.target = "_blank";
      titleLink.rel = "noopener noreferrer";
      titleLink.textContent = repo.name;
      title.append(titleLink);
      body.append(title);

      body.append(makeText("p", "project-summary", repo.description ?? ""));
      const tags = makeTags(repo, "dynamic-project-tags");
      if (tags) body.append(tags);

      const details = [repo.language, repo.stars > 0 ? `★ ${repo.stars}` : null]
        .filter(Boolean)
        .join(" · ");
      if (details) body.append(makeText("p", "muted project-summary", details));

      body.append(makeText("span", "project-more", `${openRepo} ›`));
      article.append(coverLink, body);
      return article;
    };

    const makeFeatured = (repo: Repo) => {
      const article = document.createElement("article");
      article.className = "pinned-featured";

      const coverLink = document.createElement("a");
      coverLink.className = "pinned-featured-cover";
      coverLink.href = repo.url;
      coverLink.target = "_blank";
      coverLink.rel = "noopener noreferrer";
      coverLink.append(makeCover(repo, true));

      const body = document.createElement("div");
      body.className = "pinned-featured-body";
      body.append(
        makeText(
          "p",
          "pinned-featured-eyebrow",
          `★ ${featuredLabel} · ${categoryLabel(repo.category)}`,
        ),
      );

      const title = document.createElement("h2");
      title.className = "pinned-featured-title";
      const link = document.createElement("a");
      link.href = repo.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = repo.name;
      title.append(link);
      body.append(title);

      body.append(makeText("p", "pinned-featured-summary", repo.description ?? ""));
      const tags = makeTags(repo, "pinned-featured-tags");
      if (tags) body.append(tags);

      const actions = document.createElement("div");
      actions.className = "pinned-featured-actions";
      const action = document.createElement("a");
      action.className = "btn btn--primary";
      action.href = repo.url;
      action.target = "_blank";
      action.rel = "noopener noreferrer";
      action.textContent = openRepo;
      actions.append(action);
      body.append(actions);

      article.append(coverLink, body);
      return article;
    };

    const staticProfessionalCards = Array.from(
      grid.querySelectorAll<HTMLElement>(".project-card:not(.dynamic-project-card)"),
    );
    staticProfessionalCards.forEach((card) => {
      card.dataset.category = "professional-work";
    });

    const setCount = () => {
      if (!countEl) return;
      const visible = Array.from(grid.querySelectorAll<HTMLElement>(".project-card"))
        .filter((card) => !card.hidden).length;
      countEl.textContent = visible === 1 ? countOne : countMany.replace("{n}", String(visible));
      if (emptyEl) emptyEl.hidden = visible > 0;
    };

    const applyFilter = () => {
      Array.from(grid.querySelectorAll<HTMLElement>(".project-card")).forEach((card) => {
        const show = activeFilter === "*" || card.dataset.category === activeFilter;
        card.hidden = !show;
      });
      setCount();
    };

    const buildFilters = (repos: Repo[]) => {
      if (!filterRoot) return;
      const categories = new Set<Category>(
        repos.slice(1).map((repo) => repo.category),
      );
      if (staticProfessionalCards.length) categories.add("professional-work");

      const oldButtons = Array.from(filterRoot.querySelectorAll("button"));
      oldButtons.forEach((button) => button.remove());

      const makeButton = (key: string, label: string) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `filter-pill${key === "*" ? " is-active" : ""}`;
        button.dataset.filter = key;
        button.setAttribute("aria-pressed", String(key === "*"));
        button.textContent = label;
        return button;
      };

      filterRoot.prepend(makeButton("*", allLabel));
      categories.forEach((category) => {
        filterRoot.insertBefore(makeButton(category, categoryLabel(category)), countEl);
      });
      filterRoot.hidden = categories.size < 1;
    };

    filterRoot?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-pill");
      if (!button) return;
      activeFilter = button.dataset.filter ?? "*";
      filterRoot.querySelectorAll<HTMLButtonElement>(".filter-pill").forEach((pill) => {
        const active = pill === button;
        pill.classList.toggle("is-active", active);
        pill.setAttribute("aria-pressed", String(active));
      });
      applyFilter();
    });

    try {
      const response = await fetch(`/api/github-pinned?t=${Date.now()}`, {
        headers: { Accept: "application/json" },
        cache: "no-store",
      });
      if (!response.ok) throw new Error(String(response.status));
      const payload = (await response.json()) as { repositories?: Repo[] };
      const repos = (payload.repositories ?? []).slice(0, limit);
      if (!repos.length) throw new Error("empty");

      loadingEl?.remove();

      if (mode === "home") {
        staticProfessionalCards.forEach((card) => card.remove());
        repos.forEach((repo) => grid.append(makeCard(repo)));
        return;
      }

      if (featuredRoot) {
        featuredRoot.replaceChildren(makeFeatured(repos[0]));
      }

      const professionals = staticProfessionalCards.map((card) => card);
      professionals.forEach((card) => card.remove());
      repos.slice(1).forEach((repo) => grid.append(makeCard(repo)));
      professionals.forEach((card) => grid.append(card));

      buildFilters(repos);
      applyFilter();
    } catch {
      loadingEl?.remove();
      if (featuredRoot) {
        featuredRoot.replaceChildren(
          makeText("p", "pinned-state muted", root.dataset.unavailable ?? "Projects unavailable"),
        );
      }
      if (mode === "home") {
        grid.replaceChildren(
          makeText("p", "pinned-state muted", root.dataset.unavailable ?? "Projects unavailable"),
        );
      } else {
        buildFilters([]);
        applyFilter();
      }
    }
  });
</script>
