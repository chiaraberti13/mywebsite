---
import Icon from "./Icon.astro";
import { site, type SocialLink } from "@/config/site";

interface Props {
  size?: number;
  class?: string;
  /** Escludi alcune piattaforme, es. ["email"] */
  exclude?: string[];
  showHandles?: boolean;
  label?: string;
}
const { size = 20, class: cls = "", exclude = [], showHandles = false, label } = Astro.props;
const links = site.socials.filter((s) => !exclude.includes(s.platform));
const labels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  instagram: "Instagram",
  x: "X",
  behance: "Behance",
  telegram: "Telegram",
  email: "Email",
  tryhackme: "TryHackMe",
};
---
{label && <p class="socials-label">{label}</p>}
<ul class={`socials ${showHandles ? "socials--handles" : ""} ${cls}`} role="list">
  {
    links.map((s: SocialLink) => (
      <li>
        <a
          href={s.url}
          class="social-link"
          aria-label={`${labels[s.platform]}: ${s.handle}`}
          rel={s.platform === "email" ? undefined : "me noopener noreferrer"}
          target={s.platform === "email" ? undefined : "_blank"}
        >
          <Icon name={s.platform === "email" ? "mail" : s.platform === "tryhackme" ? "shieldCheck" : s.platform} size={size} />
          {showHandles && <span>{s.handle}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials-label {
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .social-link {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease,
      background 0.2s ease;
  }
  .socials--handles {
    gap: 0.65rem;
  }
  .socials--handles .social-link {
    display: inline-flex;
    width: auto;
    min-height: 2.5rem;
    padding: 0.55rem 0.8rem;
    gap: 0.5rem;
    border-radius: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
  }
  .social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>
