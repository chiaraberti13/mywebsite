---
import type { Locale } from "@/config/site";

interface Props {
  lang: Locale;
  limit?: number;
  featuredFirst?: boolean;
}

const { lang, limit = 6, featuredFirst = false } = Astro.props;
const loading = lang === "it" ? "Caricamento progetti…" : "Loading projects…";
const unavailable =
  lang === "it"
    ? "I progetti non sono disponibili in questo momento."
    : "Projects are temporarily unavailable.";
const openRepo = lang === "it" ? "Apri repository" : "Open repository";
const featuredLabel = lang === "it" ? "In evidenza" : "Featured";
const repoLabel = lang === "it" ? "Repository GitHub" : "GitHub repository";
const starsLabel = lang === "it" ? "stelle" : "stars";
const forksLabel = lang === "it" ? "fork" : "forks";
---
<div
  class="github-pinned"
  data-github-pinned
  data-lang={lang}
  data-limit={limit}
  data-featured-first={featuredFirst ? "true" : "false"}
  data-unavailable={unavailable}
  data-open-repo={openRepo}
  data-featured-label={featuredLabel}
  data-repo-label={repoLabel}
  data-stars-label={starsLabel}
  data-forks-label={forksLabel}
>
  <p class="github-pinned-state muted" role="status">{loading}</p>
</div>

<noscript>
  <p class="muted">
    {lang === "it"
      ? "Abilita JavaScript per visualizzare i progetti."
      : "Enable JavaScript to view the projects."}
  </p>
</noscript>

<style>
  .github-pinned {
    min-height: 8rem;
  }
  .github-pinned-state {
    margin: 0;
    padding: 1.25rem 0;
    text-align: center;
  }

  :global(.github-featured) {
    display: grid;
    overflow: hidden;
    margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.6rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  @media (min-width: 820px) {
    :global(.github-featured) {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
    }
  }
  :global(.github-featured-visual) {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 50% 44%, var(--accent-soft), transparent 38%),
      linear-gradient(145deg, var(--surface-2), var(--surface));
  }
  @media (min-width: 820px) {
    :global(.github-featured-visual) {
      min-height: 100%;
      border-bottom: 0;
      border-inline-end: 1px solid var(--border);
    }
  }
  :global(.github-featured-visual::before) {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }
  :global(.github-featured-mark) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent-line);
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 650;
    letter-spacing: -0.08em;
  }
  :global(.github-featured-mark::before) {
    content: "</>";
    display: grid;
    place-items: center;
    width: clamp(7rem, 16vw, 10rem);
    aspect-ratio: 1;
    border: 1px solid var(--accent-line);
    border-radius: 28%;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    box-shadow: 0 18px 45px -28px var(--accent-line);
    transform: rotate(-5deg);
  }
  :global(.github-featured-body) {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
  }
  :global(.github-featured-eyebrow) {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.45rem;
    width: fit-content;
    margin: 0;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(.github-featured-title) {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  :global(.github-featured-summary) {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
    line-height: 1.6;
  }
  :global(.github-featured-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.45rem;
  }

  :global(.github-pinned-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.7rem + 1vw, 1.4rem);
  }
  @media (min-width: 680px) {
    :global(.github-pinned-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1020px) {
    :global(.github-pinned-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  :global(.github-repo-card) {
    position: relative;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  :global(.github-repo-card:hover) {
    transform: translateY(-3px);
    border-color: var(--accent-line);
    box-shadow: var(--shadow);
  }
  :global(.github-repo-link) {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.15rem, 0.9rem + 1vw, 1.5rem);
    color: inherit;
    text-decoration: none;
  }
  :global(.github-repo-head) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }
  :global(.github-repo-name) {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  :global(.github-repo-arrow) {
    flex: none;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  :global(.github-repo-description) {
    flex: 1;
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }
  :global(.github-repo-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  :global(.github-repo-language) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  :global(.github-repo-language::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-line);
  }
  :global(.github-repo-topics),
  :global(.github-featured-topics) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.github-repo-topic) {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
</style>

<script>
  type Repo = {
    name: string;
    description: string | null;
    url: string;
    language: string | null;
    stars: number;
    forks: number;
    topics: string[];
  };

  const text = (tag: string, className: string, value: string) => {
    const el = document.createElement(tag);
    el.className = className;
    el.textContent = value;
    return el;
  };

  const addMeta = (
    parent: HTMLElement,
    repo: Repo,
    starsLabel: string,
    forksLabel: string,
  ) => {
    const meta = document.createElement("div");
    meta.className = "github-repo-meta";
    if (repo.language) {
      meta.append(text("span", "github-repo-language", repo.language));
    }
    if (repo.stars > 0) {
      meta.append(text("span", "github-repo-stars", `★ ${repo.stars} ${starsLabel}`));
    }
    if (repo.forks > 0) {
      meta.append(text("span", "github-repo-forks", `⑂ ${repo.forks} ${forksLabel}`));
    }
    parent.append(meta);
  };

  const addTopics = (parent: HTMLElement, repo: Repo, className = "github-repo-topics") => {
    const topics = (repo.topics ?? []).slice(0, 5);
    if (!topics.length) return;
    const list = document.createElement("ul");
    list.className = className;
    topics.forEach((topic) => list.append(text("li", "github-repo-topic", topic)));
    parent.append(list);
  };

  const makeFeatured = (
    repo: Repo,
    openRepo: string,
    featuredLabel: string,
    repoLabel: string,
    starsLabel: string,
    forksLabel: string,
  ) => {
    const article = document.createElement("article");
    article.className = "github-featured";

    const visual = document.createElement("a");
    visual.className = "github-featured-visual";
    visual.href = repo.url;
    visual.target = "_blank";
    visual.rel = "noopener noreferrer";
    visual.setAttribute("aria-label", `${openRepo}: ${repo.name}`);
    visual.append(text("span", "github-featured-mark", ""));
    article.append(visual);

    const body = document.createElement("div");
    body.className = "github-featured-body";
    body.append(text("p", "github-featured-eyebrow", `★ ${featuredLabel} · GitHub`));
    body.append(text("h2", "github-featured-title", repo.name));
    body.append(text("p", "github-featured-summary", repo.description ?? ""));
    addMeta(body, repo, starsLabel, forksLabel);
    addTopics(body, repo, "github-featured-topics");

    const actions = document.createElement("div");
    actions.className = "github-featured-actions";
    const action = text("a", "btn btn--primary", repoLabel) as HTMLAnchorElement;
    action.href = repo.url;
    action.target = "_blank";
    action.rel = "noopener noreferrer";
    actions.append(action);
    body.append(actions);

    article.append(body);
    return article;
  };

  const makeCard = (
    repo: Repo,
    openRepo: string,
    starsLabel: string,
    forksLabel: string,
  ) => {
    const article = document.createElement("article");
    article.className = "github-repo-card";

    const link = document.createElement("a");
    link.className = "github-repo-link";
    link.href = repo.url;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.setAttribute("aria-label", `${openRepo}: ${repo.name}`);

    const head = document.createElement("div");
    head.className = "github-repo-head";
    head.append(
      text("h3", "github-repo-name", repo.name),
      text("span", "github-repo-arrow", "GitHub ↗"),
    );
    link.append(head);
    link.append(text("p", "github-repo-description", repo.description ?? ""));
    addMeta(link, repo, starsLabel, forksLabel);
    addTopics(link, repo);

    article.append(link);
    return article;
  };

  document.querySelectorAll<HTMLElement>("[data-github-pinned]").forEach(async (root) => {
    const limit = Math.max(1, Number(root.dataset.limit ?? 6));
    const featuredFirst = root.dataset.featuredFirst === "true";
    const unavailable = root.dataset.unavailable ?? "Projects unavailable";
    const openRepo = root.dataset.openRepo ?? "Open repository";
    const featuredLabel = root.dataset.featuredLabel ?? "Featured";
    const repoLabel = root.dataset.repoLabel ?? "GitHub repository";
    const starsLabel = root.dataset.starsLabel ?? "stars";
    const forksLabel = root.dataset.forksLabel ?? "forks";

    try {
      const response = await fetch("/api/github-pinned", {
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error(String(response.status));

      const payload = (await response.json()) as { repositories?: Repo[] };
      const repos = (payload.repositories ?? []).slice(0, limit);
      if (!repos.length) throw new Error("empty");

      const fragment = document.createDocumentFragment();
      const rest = [...repos];

      if (featuredFirst) {
        const first = rest.shift();
        if (first) {
          fragment.append(
            makeFeatured(first, openRepo, featuredLabel, repoLabel, starsLabel, forksLabel),
          );
        }
      }

      if (rest.length) {
        const grid = document.createElement("div");
        grid.className = "github-pinned-grid";
        rest.forEach((repo) => grid.append(makeCard(repo, openRepo, starsLabel, forksLabel)));
        fragment.append(grid);
      }

      root.replaceChildren(fragment);
    } catch {
      const state = text("p", "github-pinned-state muted", unavailable);
      state.setAttribute("role", "status");
      root.replaceChildren(state);
    }
  });
</script>
