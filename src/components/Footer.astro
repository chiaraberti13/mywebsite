---
import { site } from "@/config/site";
import { useTranslations, localePath } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SocialLinks from "./SocialLinks.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={localePath(lang, "/")} class="footer-name">{site.name}</a>
      <p class="muted footer-tagline">{t("footer.builtWith")}</p>
    </div>

    <SocialLinks size={18} exclude={[]} />
  </div>

  <div class="container footer-bottom">
    <p class="muted">© {year} {site.name}. {t("footer.rights")}</p>
    <a class="footer-privacy" href={localePath(lang, "/privacy")}>{t("footer.privacy")}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: 2.5rem 1.5rem;
    margin-top: 2rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .footer-name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .footer-tagline {
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .footer-privacy {
    color: var(--muted);
  }
  .footer-privacy:hover {
    color: var(--accent);
  }
</style>
