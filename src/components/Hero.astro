---
import { site } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations, localePath } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = content[lang].hero;
---
<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow">{h.eyebrow}</p>
    <h1 class="hero-title">{h.headline}</h1>

    <p class="hero-roles" aria-label="Roles">
      {
        h.roles.map((r, i) => (
          <>
            {i > 0 && <span class="dot" aria-hidden="true">•</span>}
            <span>{r}</span>
          </>
        ))
      }
    </p>

    <p class="hero-badge">
      <span class="hero-badge-dot" aria-hidden="true"></span>
      <span class="hero-badge-name">CompTIA Security+</span>
      <span class="hero-badge-sub">SY0-701</span>
    </p>

    <p class="lead hero-sub">{h.subheadline}</p>

    <div class="hero-actions">
      <a class="btn btn--primary" href={localePath(lang, "/contact")}>
        {t("cta.contact")}
        <Icon name="chevronRight" size={18} />
      </a>
      <a class="btn btn--ghost" href={localePath(lang, "/projects")}>
        {t("cta.viewProjects")}
      </a>
      {
        site.features.cvDownload && (
          <a class="btn btn--ghost" href={site.cvFile} download>
            <Icon name="download" size={18} />
            {t("cta.downloadCv")}
          </a>
        )
      }
    </div>

    <div class="hero-socials">
      <SocialLinks size={18} exclude={["email"]} />
    </div>
  </div>

  <div class="hero-glow" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 8vw, 7.5rem);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 54rem;
  }
  .hero-title {
    margin-top: 1rem;
    max-width: 20ch;
  }
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    align-items: center;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .hero-roles .dot {
    color: var(--accent);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    width: fit-content;
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hero-badge-name {
    font-weight: 650;
    color: var(--accent);
  }
  .hero-badge-sub {
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .hero-sub {
    margin-top: 1.5rem;
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-socials {
    margin-top: 2.25rem;
  }
  /* Ingresso in cascata degli elementi dell'hero al caricamento */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes heroIn {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }
    .hero-inner > * {
      animation: heroIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero-inner > .eyebrow { animation-delay: 0.05s; }
    .hero-inner > .hero-title { animation-delay: 0.13s; }
    .hero-inner > .hero-roles { animation-delay: 0.21s; }
    .hero-inner > .hero-badge { animation-delay: 0.29s; }
    .hero-inner > .hero-sub { animation-delay: 0.37s; }
    .hero-inner > .hero-actions { animation-delay: 0.45s; }
    .hero-inner > .hero-socials { animation-delay: 0.53s; }
  }

  /* Alone ocra decorativo, tenue, non invasivo */
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 45rem;
    height: 45rem;
    background: radial-gradient(
      circle,
      var(--accent-soft) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }
</style>
