---
import { site } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations, localePath } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = content[lang].hero;
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 class="hero-title">{h.headline}</h1>

      <p class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        <span class="hero-badge-name">CompTIA Security+</span>
        <span class="hero-badge-sub">SY0-701</span>
      </p>

      <p class="hero-roles" aria-label={h.roles.join(", ")}>
        {
          h.roles.map((r, i) => (
            <span class="role" aria-hidden={i > 0 ? "true" : undefined}>
              {r}
            </span>
          ))
        }
      </p>

      <p class="lead hero-sub">{h.subheadline}</p>

      <div class="hero-actions">
        <a class="btn btn--primary" href={localePath(lang, "/contact")}>
          {t("cta.contact")}
          <Icon name="chevronRight" size={18} />
        </a>
        <a class="btn btn--ghost" href={localePath(lang, "/projects")}>
          {t("cta.viewProjects")}
        </a>
        {
          site.features.cvDownload && (
            <a class="btn btn--ghost" href={site.cvFile} download>
              <Icon name="download" size={18} />
              {t("cta.downloadCv")}
            </a>
          )
        }
      </div>

      <div class="hero-socials">
        <SocialLinks size={18} exclude={["email"]} />
      </div>

      <a class="hero-scroll" href="#about" aria-label={t("cta.scrollDown")}>
        <span class="hero-scroll-line" aria-hidden="true"></span>
        <Icon name="chevronRight" size={16} class="hero-scroll-chevron" />
      </a>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-visual-panel">
        <svg
          class="hero-net"
          viewBox="0 0 400 460"
          role="presentation"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            <pattern id="heroGrid" width="28" height="28" patternUnits="userSpaceOnUse">
              <path d="M28 0H0V28" fill="none" stroke="currentColor" stroke-width="1" opacity="0.10" />
            </pattern>
            <radialGradient id="heroCore" cx="50%" cy="42%" r="60%">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
            </radialGradient>
          </defs>

          <rect x="0" y="0" width="400" height="460" fill="url(#heroGrid)" />
          <circle cx="200" cy="205" r="155" fill="url(#heroCore)" />

          <!-- Le competenze (nodi) convergono sul nucleo di sicurezza (centro) -->
          <g class="hero-net-links">
            <line x1="200" y1="205" x2="78"  y2="98"  />
            <line x1="200" y1="205" x2="322" y2="110" />
            <line x1="200" y1="205" x2="54"  y2="236" />
            <line x1="200" y1="205" x2="346" y2="250" />
            <line x1="200" y1="205" x2="120" y2="374" />
            <line x1="200" y1="205" x2="300" y2="388" />
            <line class="hero-net-link--faint" x1="78"  y1="98"  x2="322" y2="110" />
            <line class="hero-net-link--faint" x1="54"  y1="236" x2="120" y2="374" />
            <line class="hero-net-link--faint" x1="346" y1="250" x2="300" y2="388" />
          </g>

          <!-- Nodi-competenza: ognuno porta il glyph del proprio dominio -->
          <g class="hero-net-nodes">
            <g transform="translate(78 98)">
              <circle class="hnode-halo" r="20" />
              <circle class="hnode-bg" r="20" />
              <g class="hnode-ico" transform="translate(-10 -10) scale(0.83)">
                <rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3M13 15h4" />
              </g>
            </g>
            <g transform="translate(322 110)">
              <circle class="hnode-halo" r="20" />
              <circle class="hnode-bg" r="20" />
              <g class="hnode-ico" transform="translate(-10 -10) scale(0.83)">
                <circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5 6.6 16.6M12 7.5l5.4 9.1M6.8 19h10.4" />
              </g>
            </g>
            <g transform="translate(54 236)">
              <circle class="hnode-halo" r="18" />
              <circle class="hnode-bg" r="18" />
              <g class="hnode-ico" transform="translate(-9 -9) scale(0.75)">
                <path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12" />
              </g>
            </g>
            <g transform="translate(346 250)">
              <circle class="hnode-halo" r="19" />
              <circle class="hnode-bg" r="19" />
              <g class="hnode-ico" transform="translate(-9.5 -9.5) scale(0.79)">
                <rect x="6" y="6" width="12" height="12" rx="2" /><rect x="9.5" y="9.5" width="5" height="5" /><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
              </g>
            </g>
            <g transform="translate(120 374)">
              <circle class="hnode-halo" r="19" />
              <circle class="hnode-bg" r="19" />
              <g class="hnode-ico" transform="translate(-9.5 -9.5) scale(0.79)">
                <path d="M4.9 19.1a10 10 0 0 1 0-14.2M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M19.1 4.9a10 10 0 0 1 0 14.2" /><circle cx="12" cy="12" r="1.5" />
              </g>
            </g>
            <g transform="translate(300 388)">
              <circle class="hnode-halo" r="18" />
              <circle class="hnode-bg" r="18" />
              <g class="hnode-ico" transform="translate(-9 -9) scale(0.75)">
                <path d="M5 21V4" /><path d="M5 5h12l-2.5 3.5L17 12H5" />
              </g>
            </g>
          </g>

          <!-- Nucleo: la sicurezza, capita "a strati" (frame ruotati = profondità) -->
          <g class="hero-net-core" transform="translate(200 205)">
            <rect class="core-frame" x="-40" y="-40" width="80" height="80" rx="14" transform="rotate(18)" />
            <rect class="core-frame" x="-40" y="-40" width="80" height="80" rx="14" transform="rotate(-16)" />
            <circle class="core-disc" r="42" />
            <g class="hnode-ico core-shield" transform="translate(-18 -20) scale(1.5)">
              <path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6l-7-3Z" />
              <path d="m9 12 2 2 4-4" />
            </g>
          </g>

          <!-- Linea di scansione (ispezione / pentest) -->
          <line class="hero-net-scan" x1="0" x2="400" y1="0" y2="0" />
        </svg>

        <p class="hero-visual-caption">
          <span>secure</span><span class="dot">·</span><span>automate</span><span class="dot">·</span><span>understand</span>
        </p>
      </div>
    </div>
  </div>

  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-mesh" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 8vw, 7rem);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    }
  }
  .hero-text {
    max-width: 40rem;
  }
  .hero-title {
    margin-top: 1rem;
    max-width: 18ch;
  }

  /* ── Credenziale Security+ (accanto al titolo) ─────────────── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    width: fit-content;
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hero-badge-name {
    font-weight: 650;
    color: var(--accent);
  }
  .hero-badge-sub {
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ── Ruoli a rotazione (crossfade) ─────────────────────────── */
  .hero-roles {
    position: relative;
    margin-top: 1.25rem;
    min-height: 1.6em;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--text);
  }
  .hero-roles .role {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .hero-roles .role::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* 3 ruoli · 2.8s ciascuno = ciclo di 8.4s */
    .hero-roles .role {
      position: absolute;
      inset: 0;
      opacity: 0;
      animation: roleCycle 8.4s infinite;
    }
    .hero-roles .role:nth-child(1) { animation-delay: 0s; }
    .hero-roles .role:nth-child(2) { animation-delay: 2.8s; }
    .hero-roles .role:nth-child(3) { animation-delay: 5.6s; }
    @keyframes roleCycle {
      0%   { opacity: 0; transform: translateY(0.4em); }
      6%   { opacity: 1; transform: translateY(0); }
      28%  { opacity: 1; transform: translateY(0); }
      34%  { opacity: 0; transform: translateY(-0.4em); }
      100% { opacity: 0; transform: translateY(-0.4em); }
    }
  }
  /* Fallback senza animazione: lista statica con separatori */
  @media (prefers-reduced-motion: reduce) {
    .hero-roles {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.9rem;
      color: var(--muted);
    }
    .hero-roles .role[aria-hidden="true"] {
      display: inline-flex;
    }
  }

  .hero-sub {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-socials {
    margin-top: 2.25rem;
  }

  /* ── Indicatore di scroll ──────────────────────────────────── */
  .hero-scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2.5rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .hero-scroll:hover {
    color: var(--accent);
  }
  .hero-scroll-line {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(to bottom, transparent, var(--accent));
  }
  .hero-scroll-chevron {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll-chevron {
      animation: scrollBob 1.8s ease-in-out infinite;
    }
    @keyframes scrollBob {
      0%, 100% { transform: rotate(90deg) translateX(0); }
      50%      { transform: rotate(90deg) translateX(4px); }
    }
  }

  /* ── Colonna visiva ────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  .hero-visual-panel {
    position: relative;
    aspect-ratio: 5 / 6;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, var(--surface) 0%, var(--surface-2) 100%);
    box-shadow: var(--shadow);
    overflow: hidden;
    color: var(--accent);
  }
  .hero-net {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Gerarchia di disegno (dal fondo alla cima, come l'ordine nel markup):
     griglia → glow → collegamenti → nodi → nucleo → scansione. */
  .hero-net-links line {
    stroke: var(--accent);
    stroke-width: 1.4;
    fill: none;
    opacity: 0.42;
  }
  .hero-net-link--faint {
    opacity: 0.18;
  }
  .hnode-bg {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .hnode-ico {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hnode-halo {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    opacity: 0;
  }
  .core-frame {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.38;
  }
  .core-disc {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .core-shield {
    stroke-width: 1.4;
  }
  .hero-net-scan {
    stroke: var(--accent);
    stroke-width: 1.4;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hnode-halo {
      transform-box: fill-box;
      transform-origin: center;
      animation: haloPulse 3.4s ease-in-out infinite;
    }
    .hero-net-nodes > g:nth-child(1) .hnode-halo { animation-delay: 0s; }
    .hero-net-nodes > g:nth-child(2) .hnode-halo { animation-delay: 0.55s; }
    .hero-net-nodes > g:nth-child(3) .hnode-halo { animation-delay: 1.1s; }
    .hero-net-nodes > g:nth-child(4) .hnode-halo { animation-delay: 1.65s; }
    .hero-net-nodes > g:nth-child(5) .hnode-halo { animation-delay: 2.2s; }
    .hero-net-nodes > g:nth-child(6) .hnode-halo { animation-delay: 2.75s; }
    @keyframes haloPulse {
      0%   { opacity: 0.5; transform: scale(1); }
      60%, 100% { opacity: 0; transform: scale(1.55); }
    }
    .hero-net-core {
      transform-box: view-box;
      transform-origin: 200px 205px;
      animation: coreBreathe 5s ease-in-out infinite;
    }
    @keyframes coreBreathe {
      0%, 100% { transform: translate(200px, 205px) scale(1); }
      50%      { transform: translate(200px, 205px) scale(1.03); }
    }
    .hero-net-scan {
      animation: scanMove 6s linear infinite;
    }
    @keyframes scanMove {
      0%   { transform: translateY(0); opacity: 0; }
      8%   { opacity: 0.5; }
      92%  { opacity: 0.5; }
      100% { transform: translateY(460px); opacity: 0; }
    }

    /* Parallasse leggera al movimento del puntatore: i livelli si spostano
       di poco e con intensità diversa, dando profondità al grafo.
       --px/--py sono impostati dallo script (range -1…1). */
    .hero-net-links,
    .hero-net-nodes,
    .hero-net-core {
      transition: translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .hero-visual-panel:hover .hero-net-links {
      translate: calc(var(--px, 0) * 5px) calc(var(--py, 0) * 5px);
    }
    .hero-visual-panel:hover .hero-net-nodes {
      translate: calc(var(--px, 0) * 11px) calc(var(--py, 0) * 11px);
    }
    .hero-visual-panel:hover .hero-net-core {
      translate: calc(var(--px, 0) * -6px) calc(var(--py, 0) * -6px);
    }
  }

  .hero-visual-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.9rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero-visual-caption .dot {
    color: var(--accent);
  }

  /* ── Ingresso in cascata ───────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes heroIn {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: none; }
    }
    .hero-text > * {
      animation: heroIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero-text > .eyebrow      { animation-delay: 0.05s; }
    .hero-text > .hero-title   { animation-delay: 0.13s; }
    .hero-text > .hero-badge   { animation-delay: 0.21s; }
    .hero-text > .hero-roles   { animation-delay: 0.29s; }
    .hero-text > .hero-sub     { animation-delay: 0.37s; }
    .hero-text > .hero-actions { animation-delay: 0.45s; }
    .hero-text > .hero-socials { animation-delay: 0.53s; }
    .hero-text > .hero-scroll  { animation-delay: 0.61s; }

    @keyframes heroVisualIn {
      from { opacity: 0; transform: translateY(24px) scale(0.97); }
      to   { opacity: 1; transform: none; }
    }
    .hero-visual {
      animation: heroVisualIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
    }
  }

  /* ── Alone ocra + mesh per profondità ──────────────────────── */
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 45rem;
    height: 45rem;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
    background:
      radial-gradient(38rem 26rem at 12% 8%, var(--accent-soft), transparent 55%),
      radial-gradient(30rem 22rem at 88% 92%, var(--accent-soft), transparent 55%);
  }
  :root[data-theme="dark"] .hero-mesh {
    opacity: 0.9;
  }
</style>

<script>
  // Parallasse del grafo competenze al movimento del puntatore.
  // Solo puntatori fini (no touch) e solo se l'utente non ha chiesto
  // meno movimento. Scrive variabili CSS via CSSOM (compatibile con la CSP).
  const panel = document.querySelector<HTMLElement>(".hero-visual-panel");
  const fine = window.matchMedia("(pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (panel && fine && !reduce) {
    let raf = 0;
    panel.addEventListener("pointermove", (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const r = panel.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        panel.style.setProperty("--px", String(Math.max(-1, Math.min(1, px * 2))));
        panel.style.setProperty("--py", String(Math.max(-1, Math.min(1, py * 2))));
        raf = 0;
      });
    });
    panel.addEventListener("pointerleave", () => {
      panel.style.setProperty("--px", "0");
      panel.style.setProperty("--py", "0");
    });
  }
</script>
