---
import { site } from "@/config/site";
import { content } from "@/data/content";
import { useTranslations, localePath } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SocialLinks from "./SocialLinks.astro";
import Icon from "./Icon.astro";
import HeroTerminal from "./HeroTerminal.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = content[lang].hero;
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      {/* Il ruolo prima del manifesto: `hero.eyebrow` esisteva già nei dati
          ma non veniva mai stampato, così sopra la piega mancava del tutto
          l'informazione su CHI sta parlando. */}
      <p class="eyebrow hero-eyebrow">{h.eyebrow}</p>
      <h1 class="hero-title">{h.headline}</h1>

      <p class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        <span class="hero-badge-name">CompTIA Security+</span>
        <span class="hero-badge-sub">SY0-701</span>
      </p>

      {/* Le quattro aree restano SEMPRE tutte leggibili: l'animazione è una
          luce che le percorre a turno, non una rotazione che ne nasconde tre
          su quattro. Chi guarda un istante le vede comunque tutte; chi resta
          vede il movimento. */}
      <ul class="hero-roles" role="list">
        {h.roles.map((r) => <li class="role">{r}</li>)}
      </ul>

      <div class="hero-actions">
        <a class="btn btn--primary" href={localePath(lang, "/contact")}>
          {t("cta.contact")}
          <Icon name="chevronRight" size={18} />
        </a>
        <a class="btn btn--ghost" href={localePath(lang, "/projects")}>
          {t("cta.viewProjects")}
        </a>
        {
          site.features.cvDownload && (
            <a class="btn btn--ghost" href={site.cvFile} download>
              <Icon name="download" size={18} />
              {t("cta.downloadCv")}
            </a>
          )
        }
      </div>

      <div class="hero-socials">
        <SocialLinks
          size={18}
          exclude={["email", "instagram", "github"]}
          showHandles
          label="Social account"
        />
      </div>

      <a class="hero-scroll" href="#about" aria-label={t("cta.scrollDown")}>
        <span class="hero-scroll-line" aria-hidden="true"></span>
        <Icon name="chevronRight" size={16} class="hero-scroll-chevron" />
      </a>
    </div>

    <div class="hero-visual">
      <HeroTerminal lang={lang} />
    </div>
  </div>

  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-mesh" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 5.5rem);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    }
  }
  .hero-text {
    max-width: 40rem;
  }
  .hero-title {
    margin-top: 0;
    max-width: 18ch;
    /* Più contenuto del --step-4 globale (fino a 4.2rem): il manifesto
       occupa comunque quattro righe, ma ~100px in meno, che è esattamente
       quello che serviva per riportare la CTA sopra la piega su un
       portatile (viewport utile ~780px). Resta l'elemento dominante. */
    font-size: clamp(2.2rem, 1.55rem + 2.9vw, 3.6rem);
  }

  /* ── Credenziale Security+ (accanto al titolo) ─────────────── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    width: fit-content;
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-line);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hero-badge-name {
    font-weight: 650;
    color: var(--accent-text);
  }
  .hero-badge-sub {
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ── Aree di competenza (elenco statico) ───────────────────── */
  .hero-eyebrow {
    margin-bottom: 1rem;
    /* L'occhiello del hero è lungo e va a capo: il trattino accento deve
       restare agganciato alla PRIMA riga, non centrarsi fra le due. */
    align-items: flex-start;
  }
  .hero-eyebrow::before {
    margin-top: 0.62em;
  }
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }
  .hero-roles .role {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1.5;
    /* Stato di riposo — e stato unico senza JS o con "riduci movimento".
       --muted sta a 7,25:1 su fondo chiaro: anche la voce non evidenziata
       resta ampiamente leggibile, l'animazione non è mai l'unico modo per
       accedere all'informazione. */
    color: var(--muted);
  }
  .hero-roles .role::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    /* Segno che veicola informazione (quale area è accesa): serve il 3:1
       di WCAG 1.4.11, che l'ocra pieno su fondo chiaro non raggiunge. */
    background: var(--accent-line);
    flex: none;
  }

  /* ── La luce che percorre le quattro aree ──────────────────────
     Ciclo di 10s: ogni voce resta accesa ~2s. Nessun testo viene
     nascosto, cambia solo il livello di enfasi. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-roles .role {
      animation: roleGlow 10s ease-in-out infinite both;
    }
    .hero-roles .role::before {
      animation: roleDot 10s ease-in-out infinite both;
    }
    .hero-roles .role:nth-child(1),
    .hero-roles .role:nth-child(1)::before { animation-delay: 1.1s; }
    .hero-roles .role:nth-child(2),
    .hero-roles .role:nth-child(2)::before { animation-delay: 3.6s; }
    .hero-roles .role:nth-child(3),
    .hero-roles .role:nth-child(3)::before { animation-delay: 6.1s; }
    .hero-roles .role:nth-child(4),
    .hero-roles .role:nth-child(4)::before { animation-delay: 8.6s; }

    @keyframes roleGlow {
      0%   { color: var(--muted); }
      4%   { color: var(--text); }
      20%  { color: var(--text); }
      26%  { color: var(--muted); }
      100% { color: var(--muted); }
    }
    @keyframes roleDot {
      0%   { scale: 1; box-shadow: 0 0 0 0 var(--accent-soft); }
      4%   { scale: 1.5; box-shadow: 0 0 0 5px var(--accent-soft); }
      20%  { scale: 1.5; box-shadow: 0 0 0 5px var(--accent-soft); }
      26%  { scale: 1; box-shadow: 0 0 0 0 var(--accent-soft); }
      100% { scale: 1; box-shadow: 0 0 0 0 var(--accent-soft); }
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .hero-socials {
    margin-top: 1.6rem;
  }

  /* ── Indicatore di scroll ──────────────────────────────────── */
  .hero-scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.75rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .hero-scroll:hover {
    color: var(--accent-text);
  }
  .hero-scroll-line {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(to bottom, transparent, var(--accent-line));
  }
  .hero-scroll-chevron {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll-chevron {
      animation: scrollBob 1.8s ease-in-out infinite;
    }
    @keyframes scrollBob {
      0%, 100% { transform: rotate(90deg) translateX(0); }
      50%      { transform: rotate(90deg) translateX(4px); }
    }
  }

  /* ── Colonna visiva ────────────────────────────────────────── */
  /* La scena vive tutta in <HeroTerminal>: markup, stili e regia stanno in
     un unico componente invece che sparsi fra qui e uno <script>
  // Le animazioni infinite del hero (la luce sulle aree di competenza, il
  // chevron di scorrimento) continuerebbero a girare anche fuori dallo
  // schermo: i browser non le sospendono. Qui vengono messe in PAUSA quando
  // la sezione esce dal viewport e riprese da dove erano quando rientra —
  // pausa, non riavvio, così la luce non riparte sempre dalla prima voce.
  const heroSection = document.querySelector<HTMLElement>(".hero");
  if (heroSection && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => heroSection.classList.toggle("is-paused", !entry.isIntersecting),
      { threshold: 0 },
    );
    io.observe(heroSection);
  }
</script>
