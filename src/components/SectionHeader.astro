---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
  align?: "start" | "center";
  level?: "h1" | "h2";
}
const { eyebrow, title, intro, id, align = "start", level = "h2" } = Astro.props;
const Heading = level;
---
<header class:list={["section-header", { center: align === "center" }]} id={id} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading>{title}</Heading>
  {intro && <p class="lead">{intro}</p>}
</header>

<style>
  .section-header {
    margin-bottom: clamp(1.75rem, 1rem + 3vw, 3rem);
    max-width: 60ch;
  }
  .section-header :is(h1, h2) {
    margin-top: 0.6rem;
    font-size: var(--step-3);
  }
  .section-header .lead {
    margin-top: 0.9rem;
  }
  .center {
    margin-inline: auto;
    text-align: center;
  }
  .center .eyebrow {
    justify-content: center;
  }
  .center .lead {
    margin-inline: auto;
  }
</style>
