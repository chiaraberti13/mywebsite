---
import type { Locale } from "@/config/site";

interface Props { lang: Locale }
const { lang } = Astro.props;

const items = lang === "it"
  ? [
      { label: "Curiosità", value: "Proattiva" },
      { label: "Apprendimento", value: "Costante" },
      { label: "Etica", value: "Non negoziabile" },
      { label: "Lavoro di squadra", value: "Naturale" },
      { label: "Adattabilità", value: "Trasversale" },
    ]
  : [
      { label: "Curiosity", value: "always_on" },
      { label: "Learning", value: "continuous" },
      { label: "Ethics", value: "non_negotiable" },
      { label: "Teamwork", value: "built_in" },
      { label: "Adaptability", value: "active" },
    ];
---
<div class="stats-wrap">
  <ul class="stats" role="list">
    {items.map((item) => (
      <li class="stat">
        <span class="stat-label">{item.label}</span>
        <span class="stat-value">{item.value}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .stats-wrap {
    container-type: inline-size;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.7rem, 0.45rem + 0.8vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @container (min-width: 34rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (min-width: 62rem) {
    .stats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: clamp(1rem, 0.8rem + 1vw, 1.35rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: translate 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 3px;
    border-radius: 999px;
    background: var(--border);
    transition: background 0.2s ease;
  }
  .stat:hover {
    translate: 0 -3px;
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .stat:hover::before {
    background: var(--accent);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.25rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stat {
      opacity: 0;
      animation: statIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .stat:nth-child(1) { animation-delay: 0.05s; }
    .stat:nth-child(2) { animation-delay: 0.13s; }
    .stat:nth-child(3) { animation-delay: 0.21s; }
    .stat:nth-child(4) { animation-delay: 0.29s; }
    .stat:nth-child(5) { animation-delay: 0.37s; }
    @keyframes statIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }
</style>
