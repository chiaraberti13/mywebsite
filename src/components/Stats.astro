---
import type { Locale } from "@/config/site";

interface Props { lang: Locale }
const { lang } = Astro.props;

const principles = lang === "it"
  ? [
      { key: "CURIOSITÀ", value: "sempre_attiva" },
      { key: "APPRENDIMENTO", value: "continuo" },
      { key: "ETICA", value: "non_negoziabile" },
      { key: "LAVORO DI SQUADRA", value: "naturale" },
      { key: "ADATTABILITÀ", value: "attiva" },
    ]
  : [
      { key: "CURIOSITY", value: "always_on" },
      { key: "LEARNING", value: "continuous" },
      { key: "ETHICS", value: "non_negotiable" },
      { key: "TEAMWORK", value: "built_in" },
      { key: "ADAPTABILITY", value: "active" },
    ];

const method = lang === "it"
  ? ["CAPIRE", "COSTRUIRE", "TESTARE", "MIGLIORARE"]
  : ["UNDERSTAND", "BUILD", "TEST", "IMPROVE"];
---
<div class="principles" data-reveal>
  <p class="principles-command"><span aria-hidden="true">$</span> cat principles.conf</p>

  <ul class="principles-grid" role="list">
    {principles.map((item) => (
      <li>
        <span class="principle-key">{item.key}</span>
        <span class="principle-value">{item.value}</span>
      </li>
    ))}
  </ul>

  <div class="principles-footer">
    <div>
      <p class="method" aria-label={method.join(", ")}>
        {method.map((step, index) => (
          <>
            <span>{step}</span>
            {index < method.length - 1 && <b aria-hidden="true">→</b>}
          </>
        ))}
      </p>
      <p class="principles-values">
        {lang === "it"
          ? "ETICA · CURIOSITÀ · APPRENDIMENTO CONTINUO"
          : "ETHICS · CURIOSITY · CONTINUOUS LEARNING"}
      </p>
    </div>
    <p class="open-to-work"><span aria-hidden="true"></span> OPEN TO WORK</p>
  </div>
</div>

<style>
  .principles {
    padding: clamp(1.25rem, 0.9rem + 1.8vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    overflow: hidden;
  }
  .principles-command {
    margin-bottom: clamp(1.4rem, 1rem + 2vw, 2.2rem);
    font-size: clamp(1.15rem, 0.95rem + 1vw, 1.6rem);
    color: var(--accent-text);
  }
  .principles-command > span {
    margin-right: 0.6rem;
    color: var(--accent);
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 0.6rem + 1.5vw, 2rem);
    margin: 0;
    padding: 0 0 clamp(1.5rem, 1rem + 2vw, 2.2rem);
    list-style: none;
    border-bottom: 1px solid var(--border);
  }
  .principles-grid li {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }
  .principle-key {
    font-size: clamp(0.68rem, 0.62rem + 0.25vw, 0.82rem);
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .principle-value {
    font-size: clamp(0.95rem, 0.82rem + 0.55vw, 1.25rem);
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .principles-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: clamp(1.25rem, 0.9rem + 1.6vw, 1.8rem);
  }
  .method {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    font-size: clamp(0.82rem, 0.74rem + 0.4vw, 1rem);
    font-weight: 650;
    color: var(--text);
  }
  .method b {
    color: var(--accent);
  }
  .principles-values {
    margin-top: 0.85rem;
    font-size: clamp(0.68rem, 0.62rem + 0.25vw, 0.78rem);
    color: var(--accent);
  }
  .open-to-work {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
    color: var(--accent);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .open-to-work > span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  @media (max-width: 800px) {
    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .principles-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 480px) {
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
