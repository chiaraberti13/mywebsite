---
import type { Locale } from "@/config/site";

interface Props { lang: Locale }
const { lang } = Astro.props;

const items = lang === "it"
  ? [
      { label: "Curiosità", value: "Proattiva" },
      { label: "Apprendimento", value: "Costante" },
      { label: "Etica", value: "Non negoziabile" },
      { label: "Lavoro di squadra", value: "Naturale" },
      { label: "Adattabilità", value: "Trasversale" },
    ]
  : [
      { label: "Curiosity", value: "always_on" },
      { label: "Learning", value: "continuous" },
      { label: "Ethics", value: "non_negotiable" },
      { label: "Teamwork", value: "built_in" },
      { label: "Adaptability", value: "active" },
    ];
---
<div class="stats-wrap">
  {/* `data-reveal-group`: le cinque voci entrano in cascata con lo STESSO
      meccanismo del resto del sito (IntersectionObserver + CSS condivisa).
      Prima avevano un'animazione tutta loro che partiva al caricamento
      della pagina, con due conseguenze: le voci si animavano anche quando
      erano ancora fuori schermo (spreco), e senza JavaScript restavano a
      `opacity: 0`, cioè invisibili — la fascia spariva del tutto. */}
  <ul class="stats" role="list" data-reveal-group>
    {items.map((item) => (
      <li class="card stat">
        <span class="stat-label">{item.label}</span>
        <span class="stat-value">{item.value}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .stats-wrap {
    container-type: inline-size;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.7rem, 0.45rem + 0.8vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @container (min-width: 34rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (min-width: 62rem) {
    .stats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: clamp(1rem, 0.8rem + 1vw, 1.35rem);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.25rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  /* L'ingresso in cascata è gestito da `[data-reveal-group]` in global.css:
     qui non serve più nessuna @keyframes. */
</style>
