---
import Icon from "./Icon.astro";

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  class?: string;
}
const { items, class: cls = "" } = Astro.props;

// BreadcrumbList per i rich result di Google (rispecchia la UI qui sotto).
const site = Astro.site;
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.label,
    ...(c.href && site ? { item: new URL(c.href, site).href } : {}),
  })),
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(crumbLd)} />
<nav class:list={["breadcrumb", cls]} aria-label="Breadcrumb">
  <ol role="list">
    {
      items.map((c, i) => (
        <li class="crumb">
          {c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
          {i < items.length - 1 && (
            <Icon name="chevronRight" size={14} class="crumb-sep" />
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.85rem;
  }
  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }
  .crumb a {
    color: var(--muted);
    font-weight: 550;
    transition: color 0.2s ease;
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .crumb [aria-current="page"] {
    color: var(--text);
    font-weight: 600;
    max-width: 26ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .crumb-sep {
    color: var(--border);
    flex: none;
  }
</style>
