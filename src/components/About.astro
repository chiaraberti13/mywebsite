---
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SectionHeader from "./SectionHeader.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const about = content[lang].about;
---
<section class="section" id="about">
  <div class="container about-grid">
    <div>
      <SectionHeader eyebrow={t("nav.about")} title={t("section.about")} />
      <div class="stack about-text" data-reveal>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="about-highlights" aria-label={lang === "it" ? "Sintesi del profilo" : "Profile summary"} data-reveal-group>
      {
        about.highlights.map((h) => (
          <div class="highlight">
            <span class="highlight-label">{h.label}</span>
            <span class="highlight-value">{h.value}</span>
          </div>
        ))
      }
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
  }
  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }
  .about-text {
    max-width: 60ch;
  }
  .about-highlights {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
    box-shadow: var(--shadow);
  }
  .highlight {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 6.25rem;
    padding: 1.15rem 1.25rem;
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 42%),
      var(--surface);
  }
  .highlight-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .highlight-value {
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 650;
    line-height: 1.25;
    color: var(--text);
  }
</style>
