---
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SectionHeader from "./SectionHeader.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const about = content[lang].about;
---
<section class="section" id="about">
  <div class="container about-grid">
    <div>
      <SectionHeader eyebrow={t("nav.about")} title={t("section.about")} />
      <div class="stack about-text" data-reveal>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="about-highlights" aria-label={lang === "it" ? "Sintesi del profilo" : "Profile summary"} data-reveal-group>
      {
        about.highlights.map((h) => (
          <div class="highlight">
            <span class="highlight-label">{h.label}</span>
            <span class="highlight-value">{h.value}</span>
          </div>
        ))
      }
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(1.75rem, 1.1rem + 3vw, 3.5rem);
  }
  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.9fr);
      align-items: center;
    }
  }
  .about-text {
    max-width: 62ch;
  }
  .about-highlights {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    align-content: center;
  }
  .highlight {
    display: grid;
    gap: 0.45rem;
    padding: clamp(1rem, 0.85rem + 0.75vw, 1.35rem);
  }
  .highlight-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .highlight-value {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.12rem);
    font-weight: 650;
    line-height: 1.35;
    color: var(--text);
  }
  @media (max-width: 859px) {
    .about-highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .about-highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
