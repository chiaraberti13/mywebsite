---
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const about = content[lang].about;
---
<section class="section" id="about">
  <div class="container about-grid">
    <div>
      <SectionHeader title={t("section.about")} />
      <div class="stack about-text" data-reveal>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="about-highlights" aria-label={lang === "it" ? "Sintesi del profilo" : "Profile summary"} data-reveal-group>
      {
        about.highlights.map((h) => {
          const isCredential = /security\+/i.test(h.value);
          return (
            <div class:list={["card highlight", { "is-credential": isCredential }]}>
              <span class="highlight-label">
                {isCredential && (
                  <Icon name="shieldCheck" size={14} class="highlight-ico" />
                )}
                {h.label}
              </span>
              <span class="highlight-value">{h.value}</span>
            </div>
          );
        })
      }
    </aside>
  </div>
</section>

<style>
  /* Il testo e le quattro sintesi erano due colonne affiancate: la colonna
     di destra (4 card in 2×2, sticky) finiva molto prima dei paragrafi e
     sotto restavano ~400px di bianco prima della sezione successiva, che
     sommati alla spaziatura di sezione facevano percepire i blocchi come
     scollegati. Le sintesi diventano una fascia orizzontale sotto al testo:
     riempiono la riga, chiudono la sezione e restano leggibili. */
  .about-grid {
    display: grid;
    gap: clamp(1.75rem, 1.1rem + 2.5vw, 2.75rem);
  }
  .about-text {
    /* Misura di riga: a piena larghezza il paragrafo arrivava a ~90
       caratteri, ben oltre il limite di lettura confortevole (~75). */
    max-width: 62ch;
  }
  .about-highlights {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    gap: 0.7rem;
  }
  @media (min-width: 560px) {
    .about-highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .about-highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(0.7rem, 0.4rem + 1vw, 1.1rem);
    }
  }
  .highlight {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: clamp(0.95rem, 0.8rem + 0.6vw, 1.2rem) clamp(1rem, 0.85rem + 0.75vw, 1.3rem);
  }
  .highlight.is-credential {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .highlight.is-credential::before {
    background: var(--accent);
  }
  .highlight-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .highlight-ico {
    color: var(--accent-text);
  }
  .highlight-value {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.12rem);
    font-weight: 650;
    line-height: 1.35;
    color: var(--text);
  }
  /* Su due colonne la credenziale certificata occupa la riga intera:
     è l'informazione con più peso e merita di non essere una card fra
     quattro uguali. Su quattro colonne resta in linea con le altre,
     distinta dal bordo e dallo sfondo accento. */
  @media (min-width: 560px) and (max-width: 899px) {
    .highlight.is-credential {
      grid-column: 1 / -1;
    }
  }
</style>
