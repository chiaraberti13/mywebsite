---
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const about = content[lang].about;
---
<section class="section" id="about">
  <div class="container about-grid">
    <div>
      <SectionHeader eyebrow={t("nav.about")} title={t("section.about")} />
      <div class="stack about-text" data-reveal>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="about-highlights" aria-label={lang === "it" ? "Sintesi del profilo" : "Profile summary"} data-reveal-group>
      {
        about.highlights.map((h) => {
          const isCredential = /security\+/i.test(h.value);
          return (
            <div class:list={["highlight", { "is-credential": isCredential }]}>
              <span class="highlight-label">
                {isCredential && (
                  <Icon name="shieldCheck" size={14} class="highlight-ico" />
                )}
                {h.label}
              </span>
              <span class="highlight-value">{h.value}</span>
            </div>
          );
        })
      }
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(1.75rem, 1.1rem + 3vw, 3.5rem);
  }
  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.9fr);
      align-items: center;
    }
  }
  .about-text {
    max-width: 62ch;
  }
  .about-highlights {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
    align-content: center;
  }
  .highlight {
    position: relative;
    display: grid;
    gap: 0.45rem;
    padding: clamp(0.95rem, 0.8rem + 0.6vw, 1.2rem) clamp(1rem, 0.85rem + 0.75vw, 1.3rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: translate 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .highlight::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 3px;
    border-radius: 999px;
    background: var(--border);
    transition: background 0.2s ease;
  }
  .highlight:hover {
    translate: 0 -3px;
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .highlight:hover::before {
    background: var(--accent);
  }
  .highlight.is-credential {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .highlight.is-credential::before {
    background: var(--accent);
  }
  .highlight-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .highlight-ico {
    color: var(--accent);
  }
  .highlight-value {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.12rem);
    font-weight: 650;
    line-height: 1.35;
    color: var(--text);
  }
  @media (max-width: 859px) {
    .about-highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .highlight.is-credential {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .about-highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
