---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";
import { content } from "@/data/content";
import type { Locale } from "@/config/site";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const apt = content[lang].aptitude;
const languages = content[lang].languages;
const interests = content[lang].interests;

// ── Geometria del radar (esagono, scala 1..max) ──────────────
const axes = apt.axes;
const max = apt.radarMax;
const n = axes.length;
const cx = 310;
const cy = 205;
const R = 160;
const vbW = 660;
const vbH = 430;
const labelR = R + 26;

const point = (i: number, r: number): [number, number] => {
  const ang = ((-90 + (360 / n) * i) * Math.PI) / 180;
  return [cx + r * Math.cos(ang), cy + r * Math.sin(ang)];
};
const fmt = (p: [number, number]) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`;
const ringPoints = (r: number) => axes.map((_, i) => fmt(point(i, r))).join(" ");

const levels = Array.from({ length: max }, (_, k) => k + 1);
const dataPts = axes.map((a, i) => point(i, (R * a.value) / max));
const dataStr = dataPts.map(fmt).join(" ");
const axisEnds = axes.map((_, i) => point(i, R));
const scale = levels.map((l) => {
  const [x, y] = point(0, (R * l) / max);
  return { l, x: (x + 7).toFixed(1), y: (y + 4).toFixed(1) };
});
const labels = axes.map((a, i) => {
  const ang = ((-90 + (360 / n) * i) * Math.PI) / 180;
  const [x, y] = point(i, labelR);
  const cos = Math.cos(ang);
  const sin = Math.sin(ang);
  const anchor = Math.abs(cos) < 0.25 ? "middle" : cos > 0 ? "start" : "end";
  const dy = sin < -0.3 ? "-0.15em" : sin > 0.3 ? "0.9em" : "0.32em";
  return { label: a.label, value: a.value, x: x.toFixed(1), y: y.toFixed(1), anchor, dy };
});
const aria =
  (lang === "it" ? "Radar dei punti di forza: " : "Strengths radar: ") +
  axes.map((a) => `${a.label} ${a.value}/${max}`).join(", ");
---
<section class="section" id="aptitude">
  <div class="container">
    <SectionHeader eyebrow={t("section.aptitudeKicker")} title={t("section.aptitude")} intro={apt.lead} />

    <div class="apt-top">
    <div class="apt-radar-card card" data-reveal>
      <svg class="radar" viewBox={`0 0 ${vbW} ${vbH}`} role="img" aria-label={aria}>
        <g class="radar-grid">
          {levels.map((l) => <polygon class="rd-grid" points={ringPoints((R * l) / max)} />)}
          {axisEnds.map(([x, y]) => (
            <line class="rd-axis" x1={cx} y1={cy} x2={x.toFixed(1)} y2={y.toFixed(1)} />
          ))}
          {scale.map((s) => (
            <text class="rd-scale" x={s.x} y={s.y}>{s.l}</text>
          ))}
        </g>
        <g class="radar-data">
          <polygon class="rd-area" points={dataStr} />
          {axes.map((a, i) => {
            const [x, y] = dataPts[i];
            return (
              <circle class="rd-dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5">
                <title>{`${a.label}: ${a.value}/${max}`}</title>
              </circle>
            );
          })}
        </g>
        <g class="radar-labels">
          {labels.map((l) => (
            <text class="rd-label" x={l.x} y={l.y} text-anchor={l.anchor} dy={l.dy}>{l.label}</text>
          ))}
        </g>
      </svg>
    </div>

    <div class="apt-working" data-reveal-group>
      <p class="apt-working-label">{apt.workingOnLabel}</p>
      <div class="apt-cards">
        {
          apt.workingOn.map((w) => (
            <div class="card apt-card">
              <h3 class="apt-card-title">
                <span class="apt-dot" aria-hidden="true" />
                {w.title}
              </h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
    </div>

    <div class="apt-meta" data-reveal-group>
      <div class="card apt-meta-card">
        <p class="apt-meta-label">
          <span class="apt-meta-ico" aria-hidden="true"><Icon name="globe" size={18} /></span>
          {t("section.languages")}
        </p>
        <ul class="apt-langs" role="list">
          {languages.map((l) => (
            <li><strong>{l.name}</strong> <span class="muted">— {l.level}</span></li>
          ))}
        </ul>
      </div>
      <div class="card apt-meta-card">
        <p class="apt-meta-label">
          <span class="apt-meta-ico" aria-hidden="true"><Icon name="heart" size={18} /></span>
          {t("section.interests")}
        </p>
        <ul class="apt-interests" role="list">
          {interests.map((i) => <li class="tag">{i}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Radar e "aree in sviluppo" affiancati su desktop */
  .apt-top {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 2.75rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .apt-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .apt-working {
      margin-top: 0 !important;
    }
  }
  .apt-radar-card {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding: clamp(1rem, 0.5rem + 2vw, 1.75rem);
    background: linear-gradient(180deg, var(--surface), var(--bg));
  }
  .rd-dot {
    cursor: help;
  }
  .radar {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .rd-grid {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }
  .rd-axis {
    stroke: var(--border);
    stroke-width: 1;
  }
  .rd-scale {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--muted);
  }
  .rd-area {
    fill: var(--accent);
    fill-opacity: 0.16;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .rd-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .rd-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 13.5px;
    fill: var(--text);
  }

  /* Animazione di ingresso del radar */
  @media (prefers-reduced-motion: no-preference) {
    .radar-grid,
    .radar-labels {
      opacity: 0;
      transition: opacity 0.6s ease;
    }
    .radar-labels {
      transition-delay: 0.25s;
    }
    .radar-data {
      opacity: 0;
      transform: scale(0.15);
      transform-origin: 310px 205px;
      transform-box: view-box;
      transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
    }
    .radar.in .radar-grid,
    .radar.in .radar-labels {
      opacity: 1;
    }
    .radar.in .radar-data {
      opacity: 1;
      transform: scale(1);
    }
  }

  .apt-working {
    margin-top: clamp(1.5rem, 1rem + 3vw, 2.5rem);
  }
  .apt-working-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .apt-cards {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 640px) {
    .apt-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .apt-card {
    padding: 1.1rem 1.25rem;
  }
  .apt-card-title {
    font-size: var(--step-0);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .apt-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .apt-meta {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    display: grid;
    gap: clamp(1rem, 0.5rem + 2vw, 1.6rem);
  }
  @media (min-width: 640px) {
    .apt-meta {
      grid-template-columns: 1fr 1fr;
    }
  }
  .apt-meta-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .apt-meta-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .apt-meta-ico {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .apt-langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 42ch;
  }
  .apt-interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>

<script>
  // Avvia l'animazione del radar quando la sezione entra in viewport.
  const radar = document.querySelector<SVGElement>("#aptitude .radar");
  if (radar) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      radar.classList.add("in");
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              radar.classList.add("in");
              obs.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );
      io.observe(radar);
    }
  }
</script>
