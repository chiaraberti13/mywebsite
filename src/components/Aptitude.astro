---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";
import { content } from "@/data/content";
import type { Locale } from "@/config/site";
import { useTranslations } from "@/i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const apt = content[lang].aptitude;
const languages = content[lang].languages;
const interests = content[lang].interests;

/* Mappa delle sei aree attitudinali.
   NON è un grafico: non ci sono livelli, scale né punteggi: un radar con
   un'area riempita promette una misurazione che qui non esiste, e le
   differenze di raggio venivano lette come un'autovalutazione (una voce
   "più bassa" delle altre). Le sei aree hanno quindi tutte lo stesso peso
   e sono disegnate come nodi collegati, nello stesso linguaggio visivo del
   grafo del hero. */
const axes = apt.axes;
const n = axes.length;
const cx = 310;
const cy = 205;
const R = 150;
const vbW = 660;
const vbH = 430;
const labelR = R + 30;

const point = (i: number, r: number): [number, number] => {
  const ang = ((-90 + (360 / n) * i) * Math.PI) / 180;
  return [cx + r * Math.cos(ang), cy + r * Math.sin(ang)];
};
const fmt = (p: [number, number]) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`;
const ringPoints = (r: number) => axes.map((_, i) => fmt(point(i, r))).join(" ");

const nodes = axes.map((a, i) => {
  const [x, y] = point(i, R);
  return { label: a, x: x.toFixed(1), y: y.toFixed(1) };
});
const hexPoints = ringPoints(R);
const labels = axes.map((a, i) => {
  const ang = ((-90 + (360 / n) * i) * Math.PI) / 180;
  const [x, y] = point(i, labelR);
  const cos = Math.cos(ang);
  const sin = Math.sin(ang);
  const anchor = Math.abs(cos) < 0.25 ? "middle" : cos > 0 ? "start" : "end";
  const dy = sin < -0.3 ? "-0.15em" : sin > 0.3 ? "0.9em" : "0.32em";
  return { label: a, x: x.toFixed(1), y: y.toFixed(1), anchor, dy };
});
const aria =
  (lang === "it" ? "Profilo attitudinale: " : "Aptitude profile: ") +
  axes.join(", ");
---
<section class="section" id="aptitude">
  <div class="container">
    <SectionHeader eyebrow={t("section.aptitudeKicker")} title={t("section.aptitude")} intro={apt.lead} />

    <div class="apt-top card" data-reveal>
    <div class="apt-radar-card">
      <svg class="radar" viewBox={`0 0 ${vbW} ${vbH}`} role="img" aria-label={aria}>
        <g class="radar-grid">
          {nodes.map((nd) => (
            <line class="rd-axis" x1={cx} y1={cy} x2={nd.x} y2={nd.y} />
          ))}
          <polygon class="rd-hex" points={hexPoints} />
        </g>
        <g class="radar-data">
          <circle class="rd-core" cx={cx} cy={cy} r="7" />
          {nodes.map((nd) => (
            <circle class="rd-dot" cx={nd.x} cy={nd.y} r="7" />
          ))}
        </g>
        <g class="radar-labels">
          {labels.map((l) => (
            <text class="rd-label" x={l.x} y={l.y} text-anchor={l.anchor} dy={l.dy}>{l.label}</text>
          ))}
        </g>
      </svg>

      {/* Sotto i 680px il diagramma non è leggibile a nessuna dimensione di
          testo (l'SVG si riduce a ~320px e le etichette con lui): al suo
          posto le stesse sei aree diventano una lista, che su schermo
          stretto comunica meglio e occupa meno spazio verticale. */}
      <ul class="apt-axes-list" role="list">
        {axes.map((a) => <li class="apt-axis">{a}</li>)}
      </ul>
    </div>

    <div class="apt-working" data-reveal-group>
      <p class="apt-working-label">{apt.workingOnLabel}</p>
      <div class="apt-cards">
        {
          apt.workingOn.map((w) => (
            <div class="apt-card">
              <h3 class="apt-card-title">
                <span class="apt-dot" aria-hidden="true" />
                {w.title}
              </h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="apt-learning">
      <h3 class="apt-learning-title">
        <span aria-hidden="true">~$</span> {apt.learning.title}
      </h3>
      <p>{apt.learning.text}</p>
      <p>{apt.learning.pathLabel}</p>
      <ul class="apt-learning-path" role="list">
        {apt.learning.path.map((item) => <li class="tag tag--neutral">{item}</li>)}
      </ul>
    </div>
    </div>

    <div class="apt-meta" data-reveal-group>
      <div class="card apt-meta-card">
        <p class="apt-meta-label">
          <span class="apt-meta-ico" aria-hidden="true"><Icon name="globe" size={18} /></span>
          {t("section.languages")}
        </p>
        <ul class="apt-langs" role="list">
          {languages.map((l) => (
            <li><strong>{l.name}</strong> <span class="muted">— {l.level}</span></li>
          ))}
        </ul>
      </div>
      <div class="card apt-meta-card">
        <p class="apt-meta-label">
          <span class="apt-meta-ico" aria-hidden="true"><Icon name="heart" size={18} /></span>
          {t("section.interests")}
        </p>
        <ul class="apt-interests" role="list">
          {interests.map((i) => <li class="tag tag--neutral">{i}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .apt-top {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 2.5rem);
    padding: clamp(1.1rem, 0.6rem + 2.5vw, 2rem);
  }
  .apt-radar-card {
    width: 100%;
    /* Ridotto da 720px: senza i cinque anelli concentrici il diagramma è
       molto più leggero e non ha bisogno di occupare ~700px di altezza per
       comunicare sei voci. A 620px le etichette restano sopra i 12px reali. */
    max-width: 620px;
    margin-inline: auto;
  }
  .radar {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .rd-axis {
    stroke: var(--accent);
    stroke-width: 1.4;
    opacity: 0.42;
  }
  .rd-hex {
    fill: var(--accent);
    fill-opacity: 0.08;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .rd-core {
    fill: var(--accent);
  }
  .rd-dot {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .rd-label {
    font-family: var(--font-sans);
    font-weight: 600;
    fill: var(--text);
    /* La misura è in unità del viewBox (660 di larghezza): quando l'SVG si
       rimpicciolisce, il testo si rimpicciolisce con lui. Su un telefono da
       390px il fattore di scala è ~0,48, quindi 13.5 diventerebbero ~6,5px
       reali. Si compensa alzando la misura man mano che lo spazio si riduce. */
    font-size: 13.5px;
  }
  @media (max-width: 900px) {
    .rd-label { font-size: 18px; }
  }

  /* ── Ripiego su schermo stretto: lista al posto del diagramma ── */
  .apt-axes-list {
    display: none;
  }
  @media (max-width: 680px) {
    .apt-radar-card .radar {
      display: none;
    }
    .apt-axes-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
  @media (max-width: 680px) and (min-width: 460px) {
    .apt-axes-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .apt-axis {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-weight: 600;
    line-height: 1.3;
  }
  .apt-axis::before {
    content: "";
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }

  /* Animazione di ingresso del radar */
  @media (prefers-reduced-motion: no-preference) {
    .radar-grid,
    .radar-labels {
      opacity: 0;
      transition: opacity 0.6s ease;
    }
    .radar-labels {
      transition-delay: 0.25s;
    }
    .radar-data {
      opacity: 0;
      transform: scale(0.15);
      transform-origin: 310px 205px;
      transform-box: view-box;
      transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
    }
    .radar.in .radar-grid,
    .radar.in .radar-labels {
      opacity: 1;
    }
    .radar.in .radar-data {
      opacity: 1;
      transform: scale(1);
    }
  }

  .apt-working {
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
  }
  .apt-working-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .apt-cards {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 640px) {
    .apt-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .apt-card {
    padding: 0.25rem 0.1rem;
  }
  .apt-card-title {
    font-size: var(--step-0);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .apt-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .apt-learning {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 4px);
    background: color-mix(in srgb, var(--accent-soft) 45%, var(--surface));
  }
  .apt-learning-title {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }
  .apt-learning-title span {
    color: var(--accent-text);
  }
  .apt-learning-path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .apt-meta {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    display: grid;
    gap: clamp(1rem, 0.5rem + 2vw, 1.6rem);
  }
  @media (min-width: 640px) {
    .apt-meta {
      grid-template-columns: 1fr 1fr;
    }
  }
  .apt-meta-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .apt-meta-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .apt-meta-ico {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 8px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .apt-langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 42ch;
  }
  .apt-interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>

<script>
  // Avvia l'animazione del radar quando la sezione entra in viewport.
  const radar = document.querySelector<SVGElement>("#aptitude .radar");
  if (radar) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || !("IntersectionObserver" in window)) {
      radar.classList.add("in");
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              radar.classList.add("in");
              obs.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );
      io.observe(radar);
    }
  }
</script>
