---
import { site } from "@/config/site";
import { useTranslations, localePath, type UIKey } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const allRoutes = [
  { key: "nav.home", path: "/" },
  { key: "nav.cv", path: "/cv" },
  { key: "nav.projects", path: "/projects" },
  { key: "nav.coverLetter", path: "/cover-letter", feature: "coverLetter" },
  { key: "nav.journal", path: "/journal", feature: "journal" },
  { key: "nav.contact", path: "/contact" },
] as { key: UIKey; path: string; feature?: keyof typeof site.features }[];
const routes = allRoutes.filter((r) => !r.feature || site.features[r.feature]);

// pathname normalizzato senza prefisso lingua, per lo stato "attivo"
const raw = Astro.url.pathname.replace(/^\/en/, "") || "/";
const current = raw.length > 1 ? raw.replace(/\/$/, "") : "/";
---
<header class="site-header">
  <div class="container header-inner">
    <a href={localePath(lang, "/")} class="brand" aria-label={site.name}>
      <span class="brand-mark">{site.initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul role="list">
        {
          routes.map((r) => {
            const isActive = r.path === current;
            return (
              <li>
                <a
                  href={localePath(lang, r.path)}
                  class:list={["nav-link", { active: isActive }]}
                  aria-current={isActive ? "page" : undefined}
                >
                  {t(r.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        class="menu-btn"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("menu.open")}
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list">
        {
          routes.map((r) => (
            <li>
              <a href={localePath(lang, r.path)} class="mobile-link">
                {t(r.key)}
                <Icon name="chevronRight" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 550;
    font-size: 0.95rem;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-link.active {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .menu-btn {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1rem;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 550;
  }
  .mobile-link:hover {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (min-width: 821px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
</script>
