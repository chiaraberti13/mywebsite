---
import { site } from "@/config/site";
import { useTranslations, localePath, type UIKey } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

type NavRoute = {
  key: UIKey;
  path: string;
  feature?: keyof typeof site.features;
  section?: boolean;
  children?: NavRoute[];
};

const allRoutes = [
  { key: "nav.home", path: "/" },
  {
    key: "nav.about",
    path: "/#about",
    section: true,
    children: [
      { key: "nav.values", path: "/#values", section: true },
      { key: "nav.skills", path: "/#skills", section: true },
      { key: "section.aptitude", path: "/#aptitude", section: true },
    ],
  },
  {
    key: "nav.education",
    path: "/formazione",
    children: [{ key: "nav.certifications", path: "/certificazioni" }],
  },
  { key: "nav.experience", path: "/esperienze" },
  { key: "nav.projects", path: "/projects" },
  { key: "nav.journal", path: "/journal", feature: "journal" },
  { key: "nav.contact", path: "/contact" },
] satisfies NavRoute[];
const routes = allRoutes.filter((r) => !r.feature || site.features[r.feature]);

// pathname normalizzato senza prefisso lingua, per lo stato "attivo"
const raw = Astro.url.pathname.replace(/^\/en/, "") || "/";
const current = raw.length > 1 ? raw.replace(/\/$/, "") : "/";

/** id di sezione della home per lo scroll-spy, ricavato da path tipo "/#about". */
const spyOf = (path: string) =>
  path.startsWith("/#") ? path.slice(2) : undefined;
// tutte le sotto-sezioni raggruppate sotto la voce padre (per evidenziarla)
const aboutGroup = ["about", "values", "skills", "aptitude"];
---
<header class="site-header">
  <div class="container header-inner">
    <a href={localePath(lang, "/")} class="brand" aria-label={site.name}>
      <span class="brand-mark">{site.initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul role="list">
        {
          routes.map((r) => {
            const isActive = !r.section && r.path === current;
            return (
              <li class:list={["nav-item", { "has-submenu": r.children?.length, "nav-item--contact": r.key === "nav.contact" }]}>
                <a
                  href={localePath(lang, r.path)}
                  class:list={["nav-link", { active: isActive }]}
                  aria-current={isActive ? "page" : undefined}
                  aria-haspopup={r.children?.length ? "true" : undefined}
                  data-spy={spyOf(r.path)}
                  data-spy-group={r.key === "nav.about" ? aboutGroup.join(" ") : undefined}
                >
                  {t(r.key)}
                  {r.children?.length ? <Icon name="chevronRight" size={14} /> : null}
                </a>
                {
                  r.children?.length ? (
                    <ul class="submenu" role="list">
                      {r.children.map((child) => (
                        <li>
                          <a
                            href={localePath(lang, child.path)}
                            class="submenu-link"
                            data-spy={spyOf(child.path)}
                          >
                            {t(child.key)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : null
                }
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn--primary header-cta" href={localePath(lang, "/contact")}>
        {t("cta.contact")}
      </a>
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        class="menu-btn"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("menu.open")}
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list">
        {
          routes.map((r) =>
            r.children?.length ? (
              /* Voci con sotto-menu: accordion, così la lista mobile resta
                 corta invece di mostrare tutto sempre aperto. */
              <li class="mobile-group">
                <div class="mobile-row">
                  <a href={localePath(lang, r.path)} class="mobile-link mobile-link--flush">
                    {t(r.key)}
                  </a>
                  <button
                    type="button"
                    class="mobile-toggle"
                    aria-expanded="false"
                    aria-label={t(r.key)}
                  >
                    <Icon name="chevronRight" size={18} />
                  </button>
                </div>
                <ul class="mobile-submenu" role="list" hidden>
                  {r.children.map((child) => (
                    <li>
                      <a href={localePath(lang, child.path)} class="mobile-link mobile-link--child">
                        {t(child.key)}
                        <Icon name="chevronRight" size={16} />
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={localePath(lang, r.path)} class="mobile-link">
                  {t(r.key)}
                  <Icon name="chevronRight" size={18} />
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }
  .site-header.is-compact {
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    box-shadow: var(--shadow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    transition: min-height 0.25s ease;
  }
  .site-header.is-compact .header-inner {
    min-height: 3.5rem;
  }
  .brand-mark {
    transition: width 0.25s ease, height 0.25s ease;
  }
  .site-header.is-compact .brand-mark {
    width: 1.85rem;
    height: 1.85rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-inner,
    .brand-mark {
      transition: none;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    white-space: nowrap;
  }
  /* La voce "Contatti" è ridondante quando il CTA in header è visibile */
  @media (min-width: 960px) {
    .nav-item--contact {
      display: none;
    }
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 550;
    font-size: 0.95rem;
    transition: color 0.2s ease, background 0.2s ease;
  }
  /* Scroll-spy: indicatore sotto la voce della sezione visibile */
  .nav-link.spy-active {
    color: var(--text);
  }
  .nav-link.spy-active::after {
    content: "";
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .submenu-link.spy-active {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .nav-link:hover,
  .nav-item:focus-within > .nav-link,
  .nav-item:hover > .nav-link {
    color: var(--text);
    background: var(--surface-2);
  }
  .has-submenu .nav-link svg {
    rotate: 90deg;
  }
  .submenu {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    display: grid !important;
    min-width: 11rem;
    gap: 0.2rem !important;
    padding: 0.45rem !important;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    translate: 0 -0.25rem;
    transition: opacity 0.18s ease, translate 0.18s ease, visibility 0.18s ease;
  }
  .nav-item:hover > .submenu,
  .nav-item:focus-within > .submenu {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }
  /* Chiusura esplicita con Esc: vince su hover/focus-within */
  .nav-item.is-dismissed > .submenu {
    opacity: 0;
    visibility: hidden;
    translate: 0 -0.25rem;
  }
  .submenu-link {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 550;
  }
  .submenu-link:hover,
  .submenu-link:focus-visible {
    color: var(--text);
    background: var(--surface-2);
  }
  /* Pagina corrente: pill piena invece del solo colore accent, che su
     testo piccolo risultava poco leggibile. */
  .nav-link.active {
    color: var(--accent-text);
    background: var(--accent-soft);
  }
  :root[data-theme="dark"] .nav-link.active {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .header-cta {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
  @media (max-width: 959px) {
    .header-cta {
      display: none;
    }
  }
  .menu-btn {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1rem;
  }
  .mobile-submenu {
    padding: 0 0 0.35rem 1rem !important;
  }
  .mobile-row {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .mobile-link--flush {
    flex: 1;
    border-bottom: 0;
  }
  .mobile-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .mobile-toggle :global(svg) {
    transition: rotate 0.2s ease;
    rotate: 90deg;
  }
  .mobile-toggle[aria-expanded="true"] :global(svg) {
    rotate: -90deg;
  }
  .mobile-toggle[aria-expanded="true"] {
    color: var(--accent);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 550;
  }
  .mobile-link:hover {
    color: var(--accent);
  }
  .mobile-link--child {
    padding-block: 0.7rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (min-width: 821px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openLabel = btn?.getAttribute("aria-label") || "Open menu";
  const closeLabel = document.documentElement.lang === "it" ? "Chiudi menu" : "Close menu";

  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    btn.setAttribute("aria-label", open ? openLabel : closeLabel);
    if (menu) menu.hidden = open;
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", openLabel);
      menu.hidden = true;
    });
  });

  // ── Accordion dei sotto-menu nel menu mobile ─────────────────
  menu?.querySelectorAll<HTMLButtonElement>(".mobile-toggle").forEach((tog) => {
    tog.addEventListener("click", () => {
      const open = tog.getAttribute("aria-expanded") === "true";
      tog.setAttribute("aria-expanded", String(!open));
      const sub = tog.closest("li")?.querySelector<HTMLElement>(".mobile-submenu");
      if (sub) sub.hidden = open;
    });
  });

  // ── Esc chiude il dropdown desktop mantenendo il focus sulla voce ──
  // Il submenu apre via :focus-within, quindi serve una classe esplicita
  // per "chiuderlo" senza perdere la posizione da tastiera. Si azzera
  // appena ci si sposta altrove.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const item = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>(
      ".nav-item.has-submenu",
    );
    if (item) {
      item.classList.add("is-dismissed");
      item.querySelector<HTMLAnchorElement>(".nav-link")?.focus();
    } else if (menu && !menu.hidden) {
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", openLabel);
      menu.hidden = true;
      btn?.focus();
    }
  });
  document.querySelectorAll<HTMLElement>(".nav-item.has-submenu").forEach((item) => {
    const clear = () => item.classList.remove("is-dismissed");
    item.addEventListener("focusout", (e) => {
      if (!item.contains(e.relatedTarget as Node)) clear();
    });
    item.addEventListener("mouseleave", clear);
  });

  // ── Header compatto allo scroll ──────────────────────────────
  const header = document.querySelector(".site-header");
  const onScroll = () => header?.classList.toggle("is-compact", window.scrollY > 12);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Scroll-spy: evidenzia la sezione visibile nella nav ──────
  const spyLinks = Array.from(
    document.querySelectorAll<HTMLElement>("[data-spy], [data-spy-group]"),
  );
  const spyIds = Array.from(
    new Set(
      spyLinks.flatMap((l) => [
        l.dataset.spy,
        ...(l.dataset.spyGroup?.split(" ") ?? []),
      ]),
    ),
  ).filter((id): id is string => Boolean(id));
  const spySections = spyIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if (spySections.length > 0) {
    const visible = new Map<string, number>();
    const setActive = (activeId: string | null) => {
      spyLinks.forEach((l) => {
        const own = l.dataset.spy;
        const group = l.dataset.spyGroup?.split(" ") ?? [];
        const on =
          activeId !== null && (own === activeId || group.includes(activeId));
        l.classList.toggle("spy-active", on);
      });
    };
    const pickActive = () => {
      let best: string | null = null;
      let bestRatio = 0;
      visible.forEach((ratio, id) => {
        if (ratio > bestRatio) {
          bestRatio = ratio;
          best = id;
        }
      });
      setActive(best);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) visible.set(e.target.id, e.intersectionRatio);
          else visible.delete(e.target.id);
        });
        pickActive();
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.2, 0.5, 1] },
    );
    spySections.forEach((s) => observer.observe(s));
  }
</script>
