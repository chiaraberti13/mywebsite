---
import { content } from "@/data/content";
import { useTranslations } from "@/i18n/ui";
import type { Locale } from "@/config/site";
import SectionHeader from "./SectionHeader.astro";
import Icon from "./Icon.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = content[lang].skills;

const iconFor = (name: string): string => {
  if (/cyber|sicur|security/i.test(name)) return "shieldCheck";
  if (/linux|network|sistem|system/i.test(name)) return "terminal";
  if (/programm/i.test(name)) return "braces";
  if (/web|database/i.test(name)) return "database";
  if (/strument|tool|metod|method/i.test(name)) return "wrench";
  return "code";
};

const references =
  lang === "it"
    ? {
        label: "Competenze documentate attraverso progetti e laboratori",
        github: "Progetti su GitHub",
        tryhackme: "Laboratori su TryHackMe · ZeroD4y",
      }
    : {
        label: "Skills documented through projects and hands-on labs",
        github: "Projects on GitHub",
        tryhackme: "Labs on TryHackMe · ZeroD4y",
      };
---
<section class="section" id="skills">
  <div class="container">
    <SectionHeader title={t("section.skills")} />

    <div class="skills-grid" data-reveal-group>
      {
        groups.map((g, i) => (
          <article class:list={["card skill-card", { "skill-card--wide": i === 0 }]}>
            <div class="skill-head">
              <span class="skill-ico" aria-hidden="true">
                <Icon name={iconFor(g.name)} size={20} />
              </span>
              <h3 class="skill-title">{g.name}</h3>
            </div>
            <ul class="skill-list" role="list">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="skill-references" data-reveal>
      <p>{references.label}</p>
      <div class="reference-links">
        <a href="https://github.com/chiaraberti13" target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={18} />
          <span>{references.github}</span>
        </a>
        <a href="https://tryhackme.com/p/ZeroD4y" target="_blank" rel="noopener noreferrer">
          <Icon name="shieldCheck" size={18} />
          <span>{references.tryhackme}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    gap: clamp(1rem, 0.5rem + 2vw, 1.6rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 680px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .skill-card--wide {
      grid-column: span 2;
    }

    /* La card larga occupa due colonne, ma il suo elenco restava a una:
       le righe arrivavano a ~90 caratteri (oltre il limite di leggibilità)
       mentre la card accanto lasciava un vuoto verticale. Su due colonne
       interne la riga torna leggibile e le due card si riallineano. */
    .skill-card--wide .skill-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.25rem;
    }
  }

  .skill-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .skill-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .skill-ico {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .skill-title {
    font-size: var(--step-0);
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
    color: var(--accent-text);
  }

  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.62rem;
  }

  .skill-list li {
    position: relative;
    padding-left: 1rem;
    color: var(--text);
    line-height: 1.55;
  }

  .skill-list li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent-text);
    font-weight: 700;
  }

  .skill-references {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .skill-references > p {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .reference-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .reference-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .reference-links a:hover {
    color: var(--accent-text);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card,
    .reference-links a {
      transition: none;
    }

    .skill-card:hover,
    .reference-links a:hover {
      transform: none;
    }
  }
</style>
