---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import ProjectCover from "./ProjectCover.astro";
import { slugOf, categoriesOf } from "@/lib/content";

interface Props {
  project: CollectionEntry<"projects">;
  href: string;
}
const { project, href } = Astro.props;
const { title, summary, tags, cover, links } = project.data;
const categories = categoriesOf(slugOf(project.id));

const platformIcon: Record<string, string> = {
  github: "github",
  behance: "behance",
  x: "x",
  instagram: "instagram",
  live: "external",
};
const platformLabel: Record<string, string> = {
  github: "GitHub",
  behance: "Behance",
  x: "X",
  instagram: "Instagram",
  live: "Live",
};
const linkEntries = Object.entries(links).filter(([, v]) => Boolean(v)) as [
  string,
  string,
][];
---
<article class="card card--link project-card" data-categories={categories.join("|")}>
  <a href={href} class="project-cover-link" tabindex="-1" aria-hidden="true">
    <ProjectCover tags={tags} cover={cover} seed={slugOf(project.id)} />
    <span class="project-cover-arrow" aria-hidden="true">
      <Icon name="arrowUpRight" size={18} />
    </span>
  </a>
  <div class="project-body">
    <h3 class="project-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="muted project-summary">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="project-tags" role="list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      linkEntries.length > 0 && (
        <div class="project-links">
          {linkEntries.map(([platform, url]) => (
            <a
              class="project-link"
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${platformLabel[platform] ?? platform} ↗`}
              title={platformLabel[platform] ?? platform}
            >
              <Icon name={platformIcon[platform] ?? "link"} size={18} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  /* Inclinazione 3D leggera che segue il puntatore. Il `transform` è
     impostato dallo script via CSSOM: il reveal globale usa la stessa
     proprietà, quindi una regola nel foglio di stile verrebbe sovrascritta.
     Qui resta solo la transizione di rientro. */
  .project-card.has-tilt {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .project-cover-link {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .project-cover-link :global(.project-cover) {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover .project-cover-link :global(.project-cover) {
    transform: scale(1.045);
  }
  .project-cover-arrow {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 2;
  }
  .project-card:hover .project-cover-arrow,
  .project-card:focus-within .project-cover-arrow {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover .project-cover-link :global(.project-cover) {
      transform: none;
    }
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.2rem, 1rem + 1vw, 1.6rem);
  }
  .project-title {
    font-size: var(--step-1);
  }
  .project-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .project-summary {
    font-size: 0.95rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-links {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
    position: relative;
    z-index: 1;
  }
  .project-link {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .project-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  // Tilt 3D leggero sulle card progetto: solo puntatori fini e solo se
  // l'utente non ha chiesto meno movimento. Il transform è applicato inline
  // via CSSOM (CSP-safe) perché il reveal globale usa la stessa proprietà.
  const fine = window.matchMedia("(pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
      let raf = 0;
      card.addEventListener("pointermove", (e) => {
        // durante il riflusso del filtro il transform è gestito dal FLIP
        if (card.classList.contains("is-moving")) return;
        if (raf) return;
        raf = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const tx = ((e.clientX - r.left) / r.width - 0.5) * 2;
          const ty = ((e.clientY - r.top) / r.height - 0.5) * 2;
          card.classList.add("has-tilt");
          card.style.transform = `perspective(900px) rotateX(${(-ty * 3).toFixed(2)}deg) rotateY(${(tx * 3).toFixed(2)}deg)`;
          raf = 0;
        });
      });
      card.addEventListener("pointerleave", () => {
        card.style.transform = "";
        window.setTimeout(() => card.classList.remove("has-tilt"), 260);
      });
    });
  }
</script>
