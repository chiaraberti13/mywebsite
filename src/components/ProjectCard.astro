---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  project: CollectionEntry<"projects">;
  href: string;
}
const { project, href } = Astro.props;
const { title, summary, tags, cover, links } = project.data;

const platformIcon: Record<string, string> = {
  github: "github",
  behance: "behance",
  x: "x",
  instagram: "instagram",
  live: "external",
};
const platformLabel: Record<string, string> = {
  github: "GitHub",
  behance: "Behance",
  x: "X",
  instagram: "Instagram",
  live: "Live",
};
const linkEntries = Object.entries(links).filter(([, v]) => Boolean(v)) as [
  string,
  string,
][];
---
<article class="card card--link project-card">
  {
    cover && (
      <a href={href} class="project-cover" tabindex="-1" aria-hidden="true">
        <img src={cover} alt="" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="project-body">
    <h3 class="project-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="muted project-summary">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="project-tags" role="list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      linkEntries.length > 0 && (
        <div class="project-links">
          {linkEntries.map(([platform, url]) => (
            <a
              class="project-link"
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${platformLabel[platform] ?? platform} ↗`}
              title={platformLabel[platform] ?? platform}
            >
              <Icon name={platformIcon[platform] ?? "link"} size={18} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .project-cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
  }
  .project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.2rem, 1rem + 1vw, 1.6rem);
  }
  .project-title {
    font-size: var(--step-1);
  }
  .project-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .project-card {
    position: relative;
  }
  .project-summary {
    font-size: 0.95rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-links {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
    position: relative;
    z-index: 1;
  }
  .project-link {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .project-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
