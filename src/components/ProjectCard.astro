---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import ProjectCover from "./ProjectCover.astro";
import { slugOf, categoryLabel } from "@/lib/content";
import { useTranslations } from "@/i18n/ui";

interface Props {
  project: CollectionEntry<"projects">;
  href: string;
}
const { project, href } = Astro.props;
const { title, summary, tags, cover, links, status, lang, category: categoryKey } = project.data;
const statusLabels =
  lang === "it"
    ? {
        active: "Attivo",
        maintained: "Mantenuto",
        production: "In produzione",
        complete: "Completato",
        beta: "Beta",
        lab: "Laboratorio",
      }
    : {
        active: "Active",
        maintained: "Maintained",
        production: "Production",
        complete: "Complete",
        beta: "Beta",
        lab: "Lab",
      };
const category = categoryLabel(categoryKey, lang);
const t = useTranslations(lang);

const platformIcon: Record<string, string> = {
  github: "github",
  behance: "behance",
  x: "x",
  instagram: "instagram",
  live: "external",
};
const platformLabel: Record<string, string> = {
  github: "GitHub",
  behance: "Behance",
  x: "X",
  instagram: "Instagram",
  live: "Live",
};
const linkEntries = Object.entries(links).filter(([, value]) => Boolean(value)) as [string, string][];

/* La categoria compariva tre volte per card: chip sulla copertina, chip nel
   corpo e primo tag dell'elenco (nel frontmatter il primo tag ripete
   l'etichetta della categoria). Il chip sulla copertina è stato rimosso in
   ProjectCover; qui si filtra il tag ridondante, senza toccare i contenuti
   dei file .md — l'etichetta resta quella già mostrata da .project-category. */
const techTags = tags.filter(
  (tag) => tag.toLowerCase() !== category.toLowerCase(),
);
---
<article class="card card--link project-card" data-category={categoryKey}>
  <a href={href} class="project-cover-link" tabindex="-1" aria-hidden="true">
    <ProjectCover tags={tags} cover={cover} seed={slugOf(project.id)} category={categoryKey} />
    <span class="project-cover-arrow" aria-hidden="true">
      <Icon name="arrowUpRight" size={18} />
    </span>
  </a>
  <div class="project-body">
    <div class="project-meta">
      <p class="project-category">{category}</p>
      {status && <p class={`project-status project-status--${status}`}>{statusLabels[status]}</p>}
    </div>
    <h3 class="project-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="muted project-summary">{summary}</p>

    {
      techTags.length > 0 && (
        <ul class="project-tags" role="list">
          {techTags.map((tag) => (
            <li class="tag tag--neutral">{tag}</li>
          ))}
        </ul>
      )
    }

    {
      linkEntries.length > 0 && (
        <div class="project-links">
          {linkEntries.map(([platform, url]) => (
            <a
              class="project-link"
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${platformLabel[platform] ?? platform} ↗`}
              title={platformLabel[platform] ?? platform}
            >
              <Icon name={platformIcon[platform] ?? "link"} size={18} />
            </a>
          ))}
        </div>
      )
    }

    {/* Affordance di lettura esplicita, coerente con le card del Journal:
        prima l'unico segnale cliccabile era la freccia che appariva in
        hover sulla copertina — invisibile a chi non passa col mouse. */}
    <span class="project-more">
      {t("cta.readMore")}
      <Icon name="chevronRight" size={16} />
    </span>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  .project-cover-link {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .project-cover-arrow {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 2;
  }
  .project-card:hover .project-cover-arrow,
  .project-card:focus-within .project-cover-arrow {
    opacity: 1;
    transform: translateY(0);
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.2rem, 1rem + 1vw, 1.6rem);
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .project-category,
  .project-status {
    width: fit-content;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }
  .project-category {
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .project-status {
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-soft);
  }
  .project-status--production,
  .project-status--complete {
    color: var(--success);
    background: color-mix(in srgb, var(--success) 12%, transparent);
  }
  .project-title {
    font-size: var(--step-1);
  }
  .project-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .project-summary {
    font-size: 0.95rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-links {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.25rem;
    position: relative;
    z-index: 1;
  }
  .project-link {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .project-link:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }
  .project-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 0.15rem;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
    transition: gap 0.2s ease;
  }
  .project-card:hover .project-more {
    gap: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-more {
      transition: none;
    }
    .project-card:hover .project-more {
      gap: 0.25rem;
    }
  }
</style>

{/*
  Qui c'era il tilt 3D al passaggio del puntatore. È stato rimosso: un solo
  hover innescava cinque effetti insieme (sollevamento della card, bordo
  accento, barretta laterale, ingrandimento della copertina, freccia in
  comparsa) più la rotazione prospettica, che per giunta forza il rendering
  del testo su un piano ruotato — su molti schermi le scritte della card
  diventavano leggermente sfocate proprio mentre le si stava leggendo.
  Restano il sollevamento, il bordo e la freccia: sufficienti a comunicare
  che la card è cliccabile. Meno JavaScript, nessun listener per card.
*/}
