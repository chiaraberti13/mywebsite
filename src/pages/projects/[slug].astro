---
import ProjectDetailView from "@/views/ProjectDetailView.astro";
import { getProjects, slugOf } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects("it");
  return projects.map((project) => ({
    params: { slug: slugOf(project.id) },
    props: { project },
  }));
}
const { project } = Astro.props;
---
<ProjectDetailView lang="it" project={project} />
